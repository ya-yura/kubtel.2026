[Unit]
Description=Kubtel Astro website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kubtel
Group=kubtel
WorkingDirectory=/srv/kubtel-site/current
EnvironmentFile=-/etc/kubtel-site.env
Environment=HOST=127.0.0.1
Environment=PORT=4321
ExecStart=/usr/bin/node /srv/kubtel-site/current/server/entry.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kubtel-site/lead-outbox
UMask=0027

[Install]
WantedBy=multi-user.target
