{
  "kind": "collectionType",
  "collectionName": "design_themes",
  "info": {
    "singularName": "design-theme",
    "pluralName": "design-themes",
    "displayName": "Design Theme"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "pageAccent": {
      "type": "enumeration",
      "enum": ["default", "business", "critical"],
      "default": "default"
    },
    "themeMode": {
      "type": "enumeration",
      "enum": ["light", "business"],
      "default": "light"
    },
    "heroVariant": {
      "type": "enumeration",
      "enum": ["standard", "business", "compact", "proof-led"],
      "default": "standard"
    },
    "sectionDensity": {
      "type": "enumeration",
      "enum": ["comfortable", "compact", "dense"],
      "default": "comfortable"
    },
    "ctaVariant": {
      "type": "enumeration",
      "enum": ["primary", "secondary", "ghost", "business", "critical"],
      "default": "primary"
    },
    "contentAlignment": {
      "type": "enumeration",
      "enum": ["start", "center", "split"],
      "default": "start"
    },
    "compositionPreset": {
      "type": "enumeration",
      "enum": [
        "page-intro",
        "card-grid",
        "service-workspace",
        "calculator-workspace",
        "contact-grid",
        "business-routing"
      ],
      "default": "page-intro"
    },
    "serviceCardLayout": {
      "type": "enumeration",
      "enum": ["grid", "list", "comparison"],
      "default": "grid"
    },
    "proofVisibility": {
      "type": "enumeration",
      "enum": ["full", "compact", "hidden"],
      "default": "full"
    },
    "statusTone": {
      "type": "enumeration",
      "enum": ["neutral", "success", "warning", "danger", "info"],
      "default": "neutral"
    },
    "notes": { "type": "text" },
    "workflowStatus": {
      "type": "enumeration",
      "enum": [
        "draft",
        "ready_for_review",
        "commercial_approved",
        "legal_approved",
        "published",
        "archived"
      ],
      "default": "draft"
    }
  }
}
