{
  "kind": "collectionType",
  "collectionName": "job_vacancies",
  "info": {
    "singularName": "job-vacancy",
    "pluralName": "job-vacancies",
    "displayName": "Job Vacancy",
    "description": "Open HR roles for the Kubtel careers page"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "department": { "type": "string", "required": true },
    "location": { "type": "string", "required": true },
    "employmentType": {
      "type": "enumeration",
      "enum": ["full_time", "part_time", "shift", "contract", "internship"],
      "required": true,
      "default": "full_time"
    },
    "status": {
      "type": "enumeration",
      "enum": ["open", "paused", "closed"],
      "required": true,
      "default": "open"
    },
    "shortDescription": { "type": "text", "required": true },
    "requirements": { "type": "json", "required": true },
    "conditions": { "type": "json", "required": true },
    "isActive": { "type": "boolean", "required": true, "default": true },
    "sortOrder": { "type": "integer", "required": true, "default": 100 },
    "contentSource": { "type": "json" },
    "workflowStatus": {
      "type": "enumeration",
      "enum": [
        "draft",
        "ready_for_review",
        "commercial_approved",
        "legal_approved",
        "published",
        "archived"
      ],
      "default": "draft"
    }
  }
}
