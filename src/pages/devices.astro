---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSitePath } from "@config/site";

const deviceGroups = [
  {
    title: "Wi‑Fi-роутеры",
    category: "Дом и офис",
    audience: "квартира, дом, офис",
    summary:
      "Роутер подбирается не по названию модели, а по площади, стенам, скорости тарифа и количеству устройств.",
    details: [
      "площадь и материал стен",
      "скорость тарифа",
      "количество телефонов, ТВ и рабочих мест"
    ],
    terms: "Модель, наличие и формат аренды или покупки сообщает менеджер после подбора.",
    href: "/connect/?service=internet#callback-request"
  },
  {
    title: "ТВ-приставки",
    category: "Домашнее ТВ",
    audience: "Интернет + ТВ",
    summary:
      "Приставка нужна не всем: сначала проверяем тип подключения, Smart TV, приложение и возможность добавить ТВ к текущему интернету.",
    details: [
      "доступность ТВ по адресу и типу подключения",
      "Smart TV, приложение или приставка",
      "номер договора, если ТВ добавляет действующий абонент"
    ],
    terms: "Модель, наличие и формат оплаты сообщаются вместе с условиями подключения ТВ.",
    href: "/connect/?service=tv#callback-request"
  },
  {
    title: "Smart TV и приложения",
    category: "Домашнее ТВ",
    audience: "действующие абоненты",
    summary:
      "Для части телевизоров достаточно приложения. Если ТВ не показывает или забыт пароль, обращение лучше направлять в поддержку.",
    details: [
      "модель телевизора или устройства",
      "доступность приложения в магазине",
      "ссылка на приложение или APK после подтверждения"
    ],
    terms: "Проверенные варианты просмотра и ссылку для вашей платформы сообщает поддержка.",
    href: "/contacts/"
  },
  {
    title: "IP-телефоны и SIP-адаптеры",
    category: "Бизнес",
    audience: "офис, ресепшен, колл-центр",
    summary:
      "Оборудование для рабочих мест операторов, стойки ресепшен или подключения аналоговых телефонов через адаптер.",
    details: ["количество SIP-портов", "городские номера", "одновременные внешние разговоры"],
    terms: "Подбор идёт вместе с расчётом телефонии и виртуальной АТС.",
    href: "/business/?calculator=telephony#business-calculators"
  },
  {
    title: "Камеры видеонаблюдения",
    category: "Бизнес",
    audience: "магазин, склад, офис",
    summary:
      "Камеры и сопутствующее оборудование для объектов, где нужен онлайн-доступ, архив и понятная схема монтажа.",
    details: ["количество точек наблюдения", "глубина архива", "монтаж и настройка"],
    terms: "Количество камер, архив и монтаж передаются в индивидуальный расчёт.",
    href: "/business/?calculator=cctv#business-calculators"
  },
  {
    title: "Оборудование для ЦОД",
    category: "Инфраструктура",
    audience: "серверы и сеть",
    summary:
      "Серверы и сетевое оборудование размещаются в стойках по параметрам colocation и регламенту доступа в ЦОД.",
    details: ["юниты и питание", "порт и IPv4", "IPMI и удалённые руки"],
    terms: "Размещение считается отдельно; доступ в ЦОД оформляется отдельной заявкой.",
    href: "/business/?calculator=colocation#business-calculators"
  }
];
---

<BaseLayout
  title="Устройства для подключения"
  description="Роутеры, ТВ-приставки, Smart TV-приложения, IP-телефоны, камеры и оборудование для услуг Kubtel."
  canonicalPath="/devices/"
>
  <section class="section-pad compact-intro devices-page">
    <p class="eyebrow">Устройства</p>
    <h1>Оборудование для подключения</h1>
    <p>
      Категории связаны с соответствующей услугой. Модели, наличие и цены не публикуются без
      актуального подтверждения поставки; их сообщает менеджер при подборе.
    </p>

    <div class="device-grid">
      {
        deviceGroups.map((group) => (
          <article class="device-card">
            <div class="service-card-head">
              <span class="service-category">{group.category}</span>
              <span class="device-audience">{group.audience}</span>
            </div>
            <h2>{group.title}</h2>
            <p>{group.summary}</p>
            <div class="device-terms">
              <strong>Что влияет на подбор</strong>
              <p>{group.terms}</p>
            </div>
            <ul class="business-mini-list">
              {group.details.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <a class="card-action" href={getSitePath(group.href)}>
              Перейти к услуге
            </a>
          </article>
        ))
      }
    </div>

    <section class="device-note" aria-label="Как уточнить оборудование">
      <h2>Что подготовить перед разговором</h2>
      <p>
        Для домашнего подключения достаточно адреса, телефона и короткого описания квартиры или
        дома. Для бизнеса пригодятся схема объекта, количество рабочих мест, камер или серверов и
        желаемый срок запуска.
      </p>
      <div class="button-row">
        <a class="card-action" href={getSitePath("/connect/#callback-request")}
          >Домашнее подключение</a
        >
        <a class="business-link" href={getSitePath("/business/request/")}>Заявка для бизнеса</a>
      </div>
    </section>

    <section class="device-note" aria-label="Телевидение и поддержка">
      <h2>ТВ: продажа или поддержка</h2>
      <p>
        Новых клиентов и переходы на пакет «Интернет + ТВ» ведём в продажи. Запросы «не показывает»,
        «забыл пароль» или «как скачать приложение» направляем в поддержку, чтобы абонент не
        заполнял лишнюю заявку на подключение.
      </p>
      <div class="button-row">
        <a class="card-action" href={getSitePath("/connect/?service=tv#callback-request")}
          >Подключить ТВ</a
        >
        <a class="business-link" href={getSitePath("/contacts/")}>Обратиться в поддержку</a>
      </div>
    </section>
  </section>
</BaseLayout>
