---
import BaseLayout from "@layouts/BaseLayout.astro";
import PromoImage from "@components/ui/PromoImage.astro";
import { getSitePath } from "@config/site";
import { promoVisuals } from "@lib/visuals";
---

<BaseLayout
  title="О локальном провайдере"
  description="Kubtel как местная команда Краснодара: живое отношение, понятные условия и внимательный сервис."
  canonicalPath="/about/"
  pageType="AboutPage"
>
  <section class="page-intro section-pad visual-intro">
    <div>
      <p class="eyebrow">О компании</p>
      <h1>Kubtel&nbsp;— местная команда, которая отвечает за связь в&nbsp;своём городе</h1>
      <p>
        Мы работаем рядом с&nbsp;абонентами, знаем город, районы и&nbsp;реальные условия
        подключения. Поэтому стараемся говорить с&nbsp;клиентом понятно и&nbsp;доводить обращение
        до&nbsp;решения.
      </p>
    </div>
    <PromoImage visual={promoVisuals.localTeam} class="is-page-intro" loading="eager" />
  </section>
  <section class="section-pad narrative-section visual-story-split">
    <PromoImage visual={promoVisuals.support} class="is-inline" showMeta={false} />
    <div>
      <h2>Понятные условия вместо давления</h2>
      <p>
        Клиенту важно заранее видеть условия, цену после акции, состав услуги и&nbsp;порядок
        обращения в поддержку. Kubtel строит коммуникацию вокруг этих вещей, а&nbsp;не вокруг
        навязанной заявки.
      </p>
      <p>
        Главный показатель доверия&nbsp;— клиенты, которые приходят по&nbsp;рекомендации. Сосед,
        коллега или технически подкованный друг советует Kubtel не&nbsp;за громкий баннер,
        а&nbsp;потому что обещанное правда происходит.
      </p>
    </div>
  </section>
  <section
    class="section-pad narrative-section visual-story-split"
    aria-labelledby="about-documents-title"
  >
    <PromoImage visual={promoVisuals.datacenter} class="is-inline" showMeta={false} />
    <div>
      <p class="eyebrow">Документы</p>
      <h2 id="about-documents-title">Условия и реквизиты</h2>
      <p>
        Юридические данные, условия связи и политика обработки персональных данных собраны в одном
        месте — без лишних переходов и поиска по сайту.
      </p>
      <a class="card-action" href={getSitePath("/documents/")}>Открыть документы</a>
    </div>
  </section>
</BaseLayout>
