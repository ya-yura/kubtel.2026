---
import Hero from "@components/sections/Hero.astro";
import HomepageControlDeck from "@components/sections/HomepageControlDeck.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getServices } from "@lib/content";

export const prerender = false;
const services = await getServices();
---

<BaseLayout
  title={"Интернет в\u00a0Краснодаре"}
  description={"Kubtel: домашний интернет, оплата, личный кабинет и тарифы для жителей Краснодара. Отдельный маршрут — для организаций."}
  canonicalPath="/"
>
  <Hero />
  <HomepageControlDeck services={services} />
</BaseLayout>
