---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@config/site";
import { officialNews } from "@content/official-news";
---

<BaseLayout
  title="Новости и изменения тарифов"
  description="Официальные публикации Kubtel: новости компании, материалы для бизнеса и сообщения об изменениях тарифов."
  canonicalPath="/news/"
>
  <section class="section-pad compact-intro news-page">
    <p class="eyebrow">Новости</p>
    <h1>Официальные публикации Kubtel</h1>
    <p>
      В ленте показаны материалы, уже опубликованные на официальном сайте. Сообщение об изменении
      тарифа содержит дату вступления, затронутые услуги и основание.
    </p>

    <div class="news-grid">
      {
        officialNews.map((item) => (
          <article class="news-card">
            <div class="service-card-head">
              <span class="service-category">{item.category}</span>
              <time>{item.publishedLabel}</time>
            </div>
            <h2>{item.title}</h2>
            <p>{item.summary}</p>
            {item.effectiveDate && (
              <dl class="requisite-list">
                <div>
                  <dt>Вступление изменений</dt>
                  <dd>{item.effectiveDate}</dd>
                </div>
                <div>
                  <dt>Затронутые тарифы</dt>
                  <dd>{item.affectedTariffs}</dd>
                </div>
                <div>
                  <dt>Основание</dt>
                  <dd>{item.basis}</dd>
                </div>
              </dl>
            )}
            <a class="card-action" href={item.href} target="_blank" rel="noopener noreferrer">
              Читать на kubtel.ru
            </a>
          </article>
        ))
      }
    </div>

    <a class="business-link" href={SITE.officialNewsUrl} target="_blank" rel="noopener noreferrer">
      Весь официальный архив новостей
    </a>
  </section>
</BaseLayout>
