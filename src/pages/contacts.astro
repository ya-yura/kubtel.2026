---
import BaseLayout from "@layouts/BaseLayout.astro";
import FaqList from "@components/sections/FaqList.astro";
import SupportPathways from "@components/sections/SupportPathways.astro";
import { getFaqItems } from "@lib/content";

const faqItems = await getFaqItems();
---

<BaseLayout
  title="Контакты Kubtel"
  description={"Телефоны, почта, адрес, чаты и ответы на частые вопросы Kubtel в одном разделе."}
  canonicalPath="/contacts/"
  pageType="ContactPage"
>
  <section class="page-intro section-pad compact-intro">
    <p class="eyebrow">Контакты</p>
    <h1>Как связаться с Kubtel</h1>
    <p>
      Все способы связаться с Kubtel и получить помощь собраны здесь: подключение, техническая
      поддержка, чаты и ответы на частые вопросы.
    </p>
  </section>
  <SupportPathways />
  <FaqList items={faqItems} />
</BaseLayout>
