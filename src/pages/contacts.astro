---
import BaseLayout from "@layouts/BaseLayout.astro";
import FaqList from "@components/sections/FaqList.astro";
import SupportPathways from "@components/sections/SupportPathways.astro";
import PageIntro from "@components/ui/PageIntro.astro";
import { getFaqItems } from "@lib/content";

const faqItems = await getFaqItems();
---

<BaseLayout
  title="Контакты Kubtel"
  description={"Телефоны, почта, адрес, чаты и ответы на частые вопросы Kubtel в одном разделе."}
  canonicalPath="/contacts/"
  pageType="ContactPage"
>
  <PageIntro
    class="compact-intro"
    eyebrow="Контакты"
    title="Как связаться с Kubtel"
    description="Все способы связаться с Kubtel и получить помощь собраны здесь: подключение, техническая поддержка, чаты и ответы на частые вопросы."
  />
  <SupportPathways />
  <FaqList items={faqItems} />
</BaseLayout>
