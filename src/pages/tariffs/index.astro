---
import BaseLayout from "@layouts/BaseLayout.astro";
import TariffGrid from "@components/sections/TariffGrid.astro";
import TariffComparison from "@components/sections/TariffComparison.astro";
import ServiceConfigurator from "@components/sections/ServiceConfigurator.astro";
import { getConfiguratorCatalog, getTariffs } from "@lib/content";
import { handleConfiguratorFormPost } from "@lib/leads/form-handlers";
import { buildInternetServiceSchema, buildOfferCatalogSchema } from "@lib/seo/schema";

const isStaticPreview = import.meta.env.PUBLIC_STATIC_PREVIEW === "true";
export const prerender = false;

const tariffs = await getTariffs();
const catalog = await getConfiguratorCatalog();
const tvChoiceItems = [
  {
    title: "Новый клиент",
    text: "Выбирает пакет «Интернет + ТВ» и оставляет адрес, телефон и желаемый сценарий просмотра."
  },
  {
    title: "Уже есть интернет Kubtel",
    text: "Указывает номер договора и уточняет, можно ли добавить ТВ к текущему типу подключения."
  },
  {
    title: "Нужна помощь с ТВ",
    text: "Если не показывает, забыт пароль или нужно приложение для Smart TV, обращение лучше отправить в поддержку."
  }
];
const leadActionResult =
  !isStaticPreview && Astro.request.method === "POST"
    ? await handleConfiguratorFormPost(await Astro.request.formData(), Astro.request)
    : undefined;
const pageSchema = [
  buildInternetServiceSchema(tariffs, "/tariffs/"),
  buildOfferCatalogSchema(tariffs, "/tariffs/")
];
---

<BaseLayout
  title="Тарифы домашнего интернета"
  description="Сравнение тарифов Kubtel для квартиры, семьи, видео, онлайн-учёбы, Smart TV и сценария Интернет + ТВ."
  canonicalPath="/tariffs/"
  pageType="CollectionPage"
  schema={pageSchema}
>
  <section class="page-intro section-pad compact-intro">
    <p class="eyebrow">Тарифы Kubtel</p>
    <h1>Тарифы, цены и условия подключения</h1>
    <p>
      Главная информация на этой странице&nbsp;— параметры тарифов, сравнение и условия подключения.
      Формулировки для физических лиц не описывают коммерческое использование связи.
    </p>
  </section>
  <TariffGrid
    tariffs={tariffs}
    title="Выберите домашний сценарий"
    lead="Каждая карточка описывает бытовое использование: видео, онлайн-учёба, игры, ТВ и несколько домашних устройств."
  />
  <TariffComparison tariffs={tariffs} />
  <section class="section-pad tv-choice-section" id="tv">
    <div class="section-heading">
      <p class="eyebrow">Интернет + ТВ</p>
      <h2>ТВ зависит от подключения и устройства</h2>
      <p>
        У Kubtel ТВ лучше выбирать как часть домашнего сценария: единый список каналов, архив
        передач и оборудование проверяются вместе с адресом, типом подключения и устройством.
      </p>
    </div>
    <div class="service-grid">
      {
        tvChoiceItems.map((item) => (
          <article class="service-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>
  </section>
  <ServiceConfigurator
    catalog={catalog}
    initialService="internet"
    actionResult={leadActionResult}
    staticPreview={isStaticPreview}
    formAction={Astro.url.pathname}
    serviceLink={{
      eyebrow: "Домашнее ТВ",
      label: "Телевидение",
      href: "/individual/tv/?tab=about#tv-connect"
    }}
  />
</BaseLayout>
