---
import BaseLayout from "@layouts/BaseLayout.astro";
import ServiceConfigurator from "@components/sections/ServiceConfigurator.astro";
import { getConfiguratorCatalog } from "@lib/content";
import { handleConfiguratorFormPost } from "@lib/leads/form-handlers";

const isStaticPreview = import.meta.env.PUBLIC_STATIC_PREVIEW === "true";
export const prerender = false;

const catalog = await getConfiguratorCatalog();

const leadActionResult =
  !isStaticPreview && Astro.request.method === "POST"
    ? await handleConfiguratorFormPost(await Astro.request.formData(), Astro.request)
    : undefined;
---

<BaseLayout
  title="Заявка на подключение"
  description="Заявка на подключение Kubtel: населённый пункт, адрес, тариф и телефон для связи со специалистом."
  canonicalPath="/connect/"
>
  <section class="page-intro section-pad compact-intro">
    <p class="eyebrow">Подключение</p>
    <h1>Заявка на подключение</h1>
    <p>
      Выберите услугу, параметры и увидьте стоимость. Телефон для связи появится после расчёта,
      когда вы решите, что вариант вам подходит.
    </p>
  </section>
  <ServiceConfigurator
    catalog={catalog}
    initialService={Astro.url.searchParams.get("service")}
    actionResult={leadActionResult}
    staticPreview={isStaticPreview}
    formAction={Astro.url.pathname}
  />
</BaseLayout>
