---
import { getSitePath } from "@config/site";

export const prerender = false;

const requestedService = Astro.url.searchParams.get("service");
const targetPath = requestedService
  ? `/individual/configurator/?service=${encodeURIComponent(requestedService)}#configurator`
  : "/individual/configurator/#configurator";

return Astro.redirect(getSitePath(targetPath), 301);
---
