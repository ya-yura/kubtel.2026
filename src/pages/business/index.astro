---
import BaseLayout from "@layouts/BaseLayout.astro";
import BusinessCalculator from "@components/sections/BusinessCalculator.astro";
import TelephonyCalculatorGroup from "@components/sections/TelephonyCalculatorGroup.astro";
import BusinessRoutingCard from "@components/ui/BusinessRoutingCard.astro";
import { getAbsoluteUrl, getPhoneHref, getSitePath, SITE } from "@config/site";
import {
  businessCalculatorConfigs,
  type BusinessCalculatorConfig
} from "@lib/business/calculator-ui";
import {
  businessProofStrip,
  businessSegments,
  businessServices,
  getBusinessSegmentPath
} from "@lib/business/content";
import { formatRubles } from "@lib/format";
import type { JsonLdObject } from "@lib/seo/schema";
import "@styles/business-page.css";

type ServiceTab = {
  slug: string;
  title: string;
  navTitle?: string;
  badge: string;
  summary: string;
  options: string[];
  config?: BusinessCalculatorConfig;
};

const requestPath = "/business/request/";
const legalRequestPath = `${requestPath}?segment=legal`;
const budgetRequestPath = `${requestPath}?segment=b2g`;
const businessPhoneHref = getPhoneHref(SITE.businessPhone);
const budgetPhoneHref = getPhoneHref(SITE.budgetPhone);
const businessJobs = [
  {
    title: "Подключить офис или точку",
    text: "Клиенту важно быстро понять техническую возможность, срок и контакт менеджера."
  },
  {
    title: "Переехать без потери связи",
    text: "При переносе услуги ключевые данные - новый адрес, желаемая дата и действующие услуги."
  },
  {
    title: "Уйти от плохого качества",
    text: "Снимаем тревогу резервными магистралями, поддержкой 24/7 и прямым контактом."
  },
  {
    title: "Не ошибиться с оплатой",
    text: "Показываем путь к оплате и объясняем, что тариф можно изменить через менеджера."
  }
];
const businessFaq = [
  {
    question: "Как быстро происходит подключение?",
    answer:
      "Типовой ориентир для стандартного подключения - 1-3 рабочих дня с момента оплаты счёта, если по адресу есть техническая возможность."
  },
  {
    question: "Можно ли сменить тариф после подключения?",
    answer:
      "Да, тариф можно изменить в любой момент через менеджера. На сайте лучше оставить заявку или позвонить в коммерческий отдел."
  },
  {
    question: "Как оплачивать услуги?",
    answer:
      "В начале месяца на почту приходят счета. Оплату нужно провести до 1 числа следующего месяца, чтобы не рисковать блокировкой услуги."
  }
];
const internetOfficeProfiles = [
  {
    slug: "small",
    title: "Малый офис",
    seats: "2-5 рабочих мест",
    speed: "10-20 Мбит/с",
    summary: "Для небольшой команды, базовой телефонии, почты, мессенджеров и рабочих сервисов.",
    configuration: "Малый офис 10-20 Мбит/с"
  },
  {
    slug: "medium",
    title: "Средний офис",
    seats: "10-15 рабочих мест",
    speed: "30-50 Мбит/с",
    summary: "Для офиса с общими файлами, CRM, видеозвонками и несколькими активными сервисами.",
    configuration: "Средний офис 30-50 Мбит/с"
  },
  {
    slug: "large",
    title: "Крупный офис",
    seats: "20 и более рабочих мест",
    speed: "70-100 Мбит/с",
    summary: "Для большого офиса, активных видеоконференций, облачных систем и резервирования.",
    configuration: "Крупный офис 70-100 Мбит/с"
  }
];

const telephonyAgencyRoutes = [
  {
    title: "Внутризоновая связь",
    text: "Тарификацию по направлениям определяет оператор дальней связи; Kubtel подключает услугу как агент."
  },
  {
    title: "Междугородная связь",
    text: "Стоимость зависит от конкретного направления и берётся из официальной таблицы оператора дальней связи."
  },
  {
    title: "Международная связь",
    text: "Цена зависит от страны, типа сети и направления, поэтому единый калькулятор давал бы неверный результат."
  }
];
const telephonyAgencyTariffsUrl = "https://kubtel.ru/files/file/tariffs-megafon.pdf";
const hotspotPlans = [
  {
    title: "Базовый",
    monthlyPrice: 1500,
    features: [
      "авторизация по звонку без лимита",
      "брендированная стартовая страница",
      "рекламный баннер",
      "база посетителей и мультиязычность"
    ]
  },
  {
    title: "Стандарт",
    monthlyPrice: 2000,
    features: [
      "возможности базового тарифа",
      "пакет 100 SMS для авторизации",
      "перенаправление после авторизации",
      "управление трафиком"
    ]
  },
  {
    title: "Премиум",
    monthlyPrice: 3000,
    features: [
      "возможности стандартного тарифа",
      "авторизация по ваучеру",
      "периодическое перенаправление",
      "до трёх страниц для перенаправления"
    ]
  }
];
const vdiPackages = [
  {
    title: "Виртуальное рабочее место",
    resources: "2 ядра, 4 ГБ ОЗУ, 50 ГБ HDD",
    features: [
      "удалённый доступ с компьютера или мобильного устройства",
      "выбранная операционная система и бизнес-приложения",
      "резервное копирование"
    ]
  }
];

const serviceTabs: ServiceTab[] = [
  {
    slug: "colocation",
    title: "Размещение оборудования",
    badge: "Калькулятор",
    summary: "Разместить сервер в Краснодаре: ЦОД Kubtel, питание, связность и регламент доступа.",
    options: ["юниты", "питание", "интернет", "IPv4", "удалённый доступ"],
    config: businessCalculatorConfigs.colocation
  },
  {
    slug: "internet",
    title: "Интернет в офис",
    badge: "Профили",
    summary: "Корпоративный доступ в интернет для офиса, магазина, склада или точки обслуживания.",
    options: ["малый офис", "средний офис", "крупный офис"]
  },
  {
    slug: "telephony",
    title: "Телефония",
    badge: "Калькулятор",
    summary: "Собственные услуги Kubtel и официальные тарифы оператора дальней связи.",
    options: ["SIP-порты", "городские номера", "линии", "ВАТС", "автооператор"],
    config: businessCalculatorConfigs.telephony
  },
  {
    slug: "vps",
    title: "Виртуальный сервер",
    navTitle: "VPS",
    badge: "Калькулятор",
    summary: "CPU, RAM, SSD, IP-адреса и резервное копирование.",
    options: ["CPU", "RAM", "SSD", "IPv4", "резервное копирование"],
    config: businessCalculatorConfigs.vps
  },
  {
    slug: "cctv",
    title: "Видеонаблюдение",
    navTitle: "Камеры",
    badge: "Калькулятор",
    summary: "Камеры, облачный архив, оборудование и монтаж для офисов, складов и торговых точек.",
    options: ["количество камер", "глубина архива", "поставка камер", "монтаж"],
    config: businessCalculatorConfigs.cctv
  },
  {
    slug: "wifi-auth",
    title: "Hot-spot",
    badge: "Тарифы",
    summary: "Гостевой Wi-Fi с подтверждёнными способами авторизации и пакетами функций.",
    options: ["Базовый", "Стандарт", "Премиум"]
  },
  {
    slug: "vdi",
    title: "Виртуальные рабочие места",
    navTitle: "VDI",
    badge: "Пакеты",
    summary: "Удалённые рабочие места с подтверждённым базовым профилем ресурсов.",
    options: ["2 ядра", "4 ГБ ОЗУ", "50 ГБ HDD"]
  }
];

function getBusinessEntryHref(slug: string) {
  return `/business/${slug}/`;
}

const pageSchema: JsonLdObject = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${getAbsoluteUrl("/business/")}#business-services`,
  name: "Kubtel для бизнеса",
  serviceType: "Телеком-услуги для бизнеса",
  areaServed: {
    "@type": "AdministrativeArea",
    name: "Краснодар и Краснодарский край"
  },
  provider: {
    "@type": "Organization",
    name: "Kubtel",
    url: getAbsoluteUrl("/")
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "B2B-услуги Kubtel",
    itemListElement: businessServices.map((service, index) => ({
      "@type": "Offer",
      position: index + 1,
      name: service.title,
      url: getAbsoluteUrl(getBusinessEntryHref(service.slug))
    }))
  }
};
---

<BaseLayout
  title="Размещение оборудования и услуги связи для бизнеса | Kubtel"
  description="ЦОД в Краснодаре и услуги связи Kubtel для бизнеса: размещение оборудования и сервера, питание, связность, калькуляторы и заявка на расчёт."
  canonicalPath="/business/"
  schema={pageSchema}
>
  <div class="business-page">
    <section class="business-compact-hero section-pad">
      <div>
        <p class="eyebrow">ЦОД в Краснодаре · связь для бизнеса</p>
        <h1>Размещение оборудования и услуги связи</h1>
        <p>
          Нужно разместить сервер в Краснодаре? Начните с параметров ЦОД: юниты, питание, связность,
          IPv4 и удалённый доступ. Рядом собраны интернет, телефония, видеонаблюдение и виртуальные
          серверы — с расчётом и заявкой в одном маршруте.
        </p>
      </div>
      <div class="business-quick-actions" aria-label="Быстрые действия">
        <a class="card-action" href={getSitePath(`${legalRequestPath}&service=connection-request`)}>
          Оставить заявку
        </a>
        <a class="business-link" href="#business-calculators">Разместить сервер в Краснодаре</a>
        <a class="business-link" href="#organization-routes">Выбрать отдел</a>
        <a class="business-link" href={getSitePath("/business/datacenter-access/")}>
          Заявка на посещение ЦОД
        </a>
        <a
          class="business-link"
          href={getSitePath(`${legalRequestPath}&service=documents-payment`)}
        >
          Запросить платёжные документы
        </a>
      </div>
    </section>

    <section
      class="section-pad business-routing-section"
      id="organization-routes"
      aria-labelledby="organization-routes-title"
    >
      <div class="section-heading">
        <p class="eyebrow">Три отдельных маршрута</p>
        <h2 id="organization-routes-title">Выберите тип организации</h2>
        <p>
          Заявка сразу попадёт нужным специалистам. Для бизнеса, государства и операторов связи
          действуют свои услуги, условия и контакты.
        </p>
      </div>

      <div class="business-routing-grid">
        <BusinessRoutingCard
          variant="legal"
          eyebrow="B2B"
          title="Для бизнеса"
          hint="Интернет, телефония, видеонаблюдение, гостевой Wi‑Fi, VPS и размещение для офисов, магазинов, кафе, клиник и складов."
          contactLabel="Контакты для бизнеса"
          email={SITE.businessEmail}
          phone={SITE.businessPhone}
          phoneHref={businessPhoneHref}
          primaryHref="/business/b2b/"
          primaryLabel="Открыть раздел B2B"
          secondaryHref={legalRequestPath}
          secondaryLabel="Сразу оставить заявку"
        />
        <BusinessRoutingCard
          variant="budget"
          eyebrow="B2G"
          title="Для государства"
          hint="Связь для федеральных и муниципальных учреждений: закупки по 44‑ФЗ и 223‑ФЗ, документы, телефония, интернет и резервирование."
          contactLabel="Контакты для государственных заказчиков"
          email={SITE.budgetEmail}
          phone={SITE.budgetPhone}
          phoneHref={budgetPhoneHref}
          primaryHref="/business/b2g/"
          primaryLabel="Открыть раздел B2G"
          secondaryHref={budgetRequestPath}
          secondaryLabel="Сразу оставить заявку"
        />
        <BusinessRoutingCard
          variant="operator"
          eyebrow="B2O"
          title="Для операторов связи"
          hint="Региональная связность, ЦОД, colocation, cross‑connect, порты и партнёрские условия для операторов и инфраструктурных команд."
          contactLabel="Контакты для операторов связи"
          email={SITE.businessEmail}
          phone={SITE.businessPhone}
          phoneHref={businessPhoneHref}
          primaryHref="/business/b2o/"
          primaryLabel="Открыть раздел B2O"
          secondaryHref={`${requestPath}?segment=b2o&service=operators`}
          secondaryLabel="Запросить условия"
        />
      </div>
    </section>

    <section class="section-pad business-jobs-section" aria-label="Задачи клиентов бизнеса">
      <div class="business-proof-strip">
        {
          businessProofStrip.map((item) => (
            <span>
              <strong>{item.label}</strong>
              {item.value}
            </span>
          ))
        }
      </div>
      <div class="business-jobs-grid">
        {
          businessJobs.map((job) => (
            <article class="business-job-card">
              <h2>{job.title}</h2>
              <p>{job.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section-pad business-service-workspace" id="business-calculators">
      <div class="section-heading">
        <p class="eyebrow">Семь направлений</p>
        <h2>Информация, расчёт и заявка</h2>
        <p>
          Четыре услуги можно собрать в калькуляторе. Для интернета выбирается профиль офиса, а
          Hot-spot и виртуальные рабочие места представлены подтверждёнными пакетами без
          неподтверждённых цен.
        </p>
      </div>

      <div class="business-service-tabs" data-business-service-tabs>
        <label class="business-service-select">
          <span>Направление</span>
          <select data-service-select aria-label="Выберите бизнес-услугу">
            {
              serviceTabs.map((item, index) => (
                <option value={item.slug} selected={index === 0}>
                  {item.title}
                </option>
              ))
            }
          </select>
        </label>
        <nav class="business-service-list" aria-label="Услуги для бизнеса">
          {
            serviceTabs.map((item, index) => (
              <button
                class="business-service-row"
                type="button"
                data-service-tab={item.slug}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{item.navTitle ?? item.title}</strong>
                <small>{item.badge}</small>
                <p>{item.summary}</p>
              </button>
            ))
          }
        </nav>

        <div class="business-service-panel" aria-live="polite">
          {
            serviceTabs.map((item, index) => (
              <article
                class:list={["business-service-panel-item", { "is-active": index === 0 }]}
                data-service-panel={item.slug}
              >
                <div class="business-service-info">
                  <span class="service-category">Информация</span>
                  <h3>{item.title}</h3>
                  <p>{item.summary}</p>
                  <ul class="business-mini-list">
                    {item.options.map((option) => (
                      <li>{option}</li>
                    ))}
                  </ul>
                </div>
                <div class="business-calculator-stack">
                  {item.slug === "internet" ? (
                    <section
                      class="office-profile-panel"
                      aria-label="Подбор интернета по размеру офиса"
                    >
                      <div class="section-heading is-tight">
                        <p class="eyebrow">Интернет в офис</p>
                        <h3>Выберите размер офиса</h3>
                        <p>
                          Ориентиры по скорости помогают быстро начать заявку. Финальную полосу и
                          техническую возможность менеджер подтвердит после проверки адреса.
                        </p>
                      </div>
                      <div class="office-profile-grid">
                        {internetOfficeProfiles.map((profile) => (
                          <article class="office-profile-card">
                            <span>{profile.seats}</span>
                            <h4>{profile.title}</h4>
                            <strong>{profile.speed}</strong>
                            <p>{profile.summary}</p>
                            <a
                              class="card-action"
                              href={getSitePath(
                                `${requestPath}?segment=legal&service=internet&officeProfile=${profile.slug}&configurationSummary=${encodeURIComponent(profile.configuration)}`
                              )}
                            >
                              Оставить заявку
                            </a>
                          </article>
                        ))}
                      </div>
                    </section>
                  ) : item.slug === "telephony" ? (
                    <>
                      <TelephonyCalculatorGroup requestPath={legalRequestPath} />
                      <section class="hotspot-plan-panel telephony-agency-panel">
                        <div class="section-heading is-tight">
                          <p class="eyebrow">Агентская схема</p>
                          <h3>Внутризоновая, междугородная и международная связь</h3>
                          <p>
                            Эти направления оказывает оператор дальней связи, а Kubtel выступает
                            агентом. Поэтому они не считаются отдельными калькуляторами.
                          </p>
                        </div>
                        <div class="hotspot-plan-grid">
                          {telephonyAgencyRoutes.map((route) => (
                            <article>
                              <h3>{route.title}</h3>
                              <p>{route.text}</p>
                            </article>
                          ))}
                        </div>
                        <a
                          class="business-link"
                          href={telephonyAgencyTariffsUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Официальные тарифы по направлениям, PDF
                        </a>
                      </section>
                    </>
                  ) : item.slug === "wifi-auth" ? (
                    <section class="hotspot-plan-panel" aria-label="Тарифы Hot-spot">
                      <div class="section-heading is-tight">
                        <p class="eyebrow">Подтверждённый состав</p>
                        <h3>Тарифы Hot-spot</h3>
                        <p>Выберите подходящий состав и стоимость тарифа в месяц.</p>
                      </div>
                      <div class="hotspot-plan-grid">
                        {hotspotPlans.map((plan) => (
                          <article>
                            <h3>{plan.title}</h3>
                            <p class="hotspot-plan-price">
                              <strong>{formatRubles(plan.monthlyPrice)}</strong>
                              <span>в месяц</span>
                            </p>
                            <ul class="business-mini-list">
                              {plan.features.map((feature) => (
                                <li>{feature}</li>
                              ))}
                            </ul>
                            <a
                              class="card-action"
                              href={getSitePath(
                                `${requestPath}?segment=legal&service=wifi-auth&monthlyEstimate=${plan.monthlyPrice}&configurationSummary=${encodeURIComponent(`Hot-spot, тариф ${plan.title} — ${formatRubles(plan.monthlyPrice)} в месяц.`)}`
                              )}
                            >
                              Оставить заявку
                            </a>
                          </article>
                        ))}
                      </div>
                      <a
                        class="business-link"
                        href="https://kubtel.ru/legal/smallbusiness/wifi/"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Официальное описание Hot-spot Kubtel
                      </a>
                    </section>
                  ) : item.slug === "vdi" ? (
                    <section
                      class="hotspot-plan-panel"
                      aria-label="Пакеты виртуальных рабочих мест"
                    >
                      <div class="section-heading is-tight">
                        <p class="eyebrow">Подтверждённый пакет</p>
                        <h3>Виртуальные рабочие места</h3>
                        <p>
                          Стоимость зависит от количества мест, ОС, приложений и лицензий и
                          рассчитывается индивидуально.
                        </p>
                      </div>
                      <div class="hotspot-plan-grid is-single">
                        {vdiPackages.map((pack) => (
                          <article>
                            <h3>{pack.title}</h3>
                            <strong>{pack.resources}</strong>
                            <ul class="business-mini-list">
                              {pack.features.map((feature) => (
                                <li>{feature}</li>
                              ))}
                            </ul>
                            <a
                              class="card-action"
                              href={getSitePath(
                                `${requestPath}?segment=legal&service=vdi&configurationSummary=${encodeURIComponent(`${pack.title}: ${pack.resources}. Индивидуальный расчёт.`)}`
                              )}
                            >
                              Оставить заявку
                            </a>
                          </article>
                        ))}
                      </div>
                      <a
                        class="business-link"
                        href="https://kubtel.ru/legal/smallbusiness/datac/vdi"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Официальное описание VDI Kubtel
                      </a>
                    </section>
                  ) : (
                    item.config && <BusinessCalculator config={item.config} />
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-pad business-ops-section">
      <div class="section-heading">
        <p class="eyebrow">Заявки и оплата</p>
