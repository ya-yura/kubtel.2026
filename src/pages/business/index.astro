---
import BaseLayout from "@layouts/BaseLayout.astro";
import BusinessCalculator from "@components/sections/BusinessCalculator.astro";
import { getAbsoluteUrl, getSitePath, SITE } from "@config/site";
import {
  businessCalculatorConfigs,
  type BusinessCalculatorConfig
} from "@lib/business/calculator-ui";
import { businessServices } from "@lib/business/content";
import type { JsonLdObject } from "@lib/seo/schema";
import "@styles/business-page.css";

type CalculatorTab = {
  slug: string;
  title: string;
  summary: string;
  options: string[];
  configs?: BusinessCalculatorConfig[];
};

const requestPath = "/business/request/";
const phoneHref = `tel:${SITE.salesPhone.replace(/\D/g, "")}`;

const calculatorTabs: CalculatorTab[] = [
  {
    slug: "internet",
    title: "Интернет",
    summary: "Корпоративный доступ в интернет для офиса, магазина, склада или точки обслуживания.",
    options: ["скорость канала", "статические IP", "резервный канал", "настройка маршрутизатора"],
    configs: [businessCalculatorConfigs.internet]
  },
  {
    slug: "colocation",
    title: "Размещение",
    summary: "Размещение серверного оборудования в ЦОД Kubtel с питанием и связностью.",
    options: ["юниты", "питание", "порт", "IPv4", "IPMI", "удалённые работы"],
    configs: [businessCalculatorConfigs.colocation]
  },
  {
    slug: "wifi-auth",
    title: "Hot-spot",
    summary: "Гостевой Wi-Fi с авторизацией посетителей для публичных точек.",
    options: ["тариф", "количество площадок", "SMS-авторизация", "брендированная страница"],
    configs: [businessCalculatorConfigs.wifi_auth]
  },
  {
    slug: "telephony",
    title: "Телефония",
    summary: "IP-телефония, внутризоновая, междугородная и международная связь.",
    options: ["SIP-порты", "городские номера", "внешние линии", "ВАТС", "направления связи"],
    configs: [
      businessCalculatorConfigs.telephony,
      businessCalculatorConfigs.telephony_intrazone,
      businessCalculatorConfigs.telephony_long_distance,
      businessCalculatorConfigs.telephony_international,
      businessCalculatorConfigs.telephony_services
    ]
  },
  {
    slug: "vps",
    title: "Виртуальный сервер",
    summary: "CPU, RAM, диски, IP-адреса и резервное копирование.",
    options: ["CPU", "RAM", "SSD/HDD", "IPv4", "резервное копирование", "DDoS-защита"],
    configs: [businessCalculatorConfigs.vps]
  }
];

const pageSchema: JsonLdObject = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${getAbsoluteUrl("/business/")}#business-services`,
  name: "Kubtel для бизнеса",
  serviceType: "Телеком-услуги для бизнеса",
  areaServed: {
    "@type": "AdministrativeArea",
    name: "Краснодар и Краснодарский край"
  },
  provider: {
    "@type": "Organization",
    name: "Kubtel",
    url: getAbsoluteUrl("/")
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "B2B-услуги Kubtel",
    itemListElement: businessServices.map((service, index) => ({
      "@type": "Offer",
      position: index + 1,
      name: service.title,
      url: getAbsoluteUrl(`/business/request/?service=${service.slug}`)
    }))
  }
};
---

<BaseLayout
  title="Kubtel для бизнеса"
  description="Услуги связи Kubtel для бизнеса: заявка, калькуляторы, доступ в ЦОД и оплата услуг."
  canonicalPath="/business/"
  schema={pageSchema}
>
  <div class="business-page">
    <section class="business-compact-hero section-pad">
      <div>
        <p class="eyebrow">Бизнесу</p>
        <h1>Услуги связи для бизнеса</h1>
        <p>
          Интернет, размещение оборудования, Hot-spot, телефония и виртуальные серверы. Выберите
          услугу, выполните предварительный расчёт и отправьте заявку на подключение.
        </p>
      </div>
      <div class="business-quick-actions" aria-label="Быстрые действия">
        <a class="card-action" href={getSitePath(`${requestPath}?service=internet`)}>Подключить</a>
        <a class="business-link" href={getSitePath(`${requestPath}?service=datacenter-access`)}>
          Заявка на посещение ЦОД
        </a>
        <a class="business-link" href={SITE.paymentUrl} target="_blank" rel="noopener noreferrer">
          Оплатить услуги
        </a>
        <a class="business-phone-card" href={phoneHref}>{SITE.salesPhone}</a>
      </div>
    </section>

    <section class="section-pad business-service-workspace" id="business-calculators">
      <div class="section-heading">
        <p class="eyebrow">Услуги и калькуляторы</p>
        <h2>Информация, расчёт и заявка</h2>
        <p>
          По каждой основной услуге доступен калькулятор и кнопка «Подключить» с передачей выбранной
          конфигурации в заявку.
        </p>
      </div>

      <div class="business-service-tabs" data-business-service-tabs>
        <nav class="business-service-list" aria-label="Услуги для бизнеса">
          {
            calculatorTabs.map((item, index) => (
              <button
                class="business-service-row"
                type="button"
                data-service-tab={item.slug}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{item.title}</strong>
                <small>Калькулятор</small>
                <p>{item.summary}</p>
              </button>
            ))
          }
        </nav>

        <div class="business-service-panel" aria-live="polite">
          {
            calculatorTabs.map((item, index) => (
              <article
                class:list={["business-service-panel-item", { "is-active": index === 0 }]}
                data-service-panel={item.slug}
              >
                <div class="business-service-info">
                  <span class="service-category">Информация</span>
                  <h3>{item.title}</h3>
                  <p>{item.summary}</p>
                  <ul class="business-mini-list">
                    {item.options.map((option) => (
                      <li>{option}</li>
                    ))}
                  </ul>
                </div>
                <div class="business-calculator-stack">
                  {item.configs?.map((config) => (
                    <BusinessCalculator config={config} />
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-pad business-ops-section">
      <div class="section-heading">
        <p class="eyebrow">Заявки и оплата</p>
        <h2>Операционные действия</h2>
      </div>
      <div class="business-ops-grid">
        <a class="business-ops-card" href={getSitePath(`${requestPath}?service=datacenter-access`)}>
          <span>ЦОД</span>
          <strong>Заявка на посещение ЦОД</strong>
          <p>Для планового доступа к оборудованию укажите площадку, дату, время и состав работ.</p>
        </a>
        <a
          class="business-ops-card"
          href={SITE.paymentUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Оплата</span>
          <strong>Оплатить услуги на сайте</strong>
          <p>Переход в личный кабинет для оплаты услуг юридических лиц и ИП.</p>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-business-service-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-service-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-service-panel]")];

    const requestedTab = new URLSearchParams(window.location.search).get("calculator");
    activate(
      tabs.some((tab) => tab.dataset.serviceTab === requestedTab) ? requestedTab : "internet"
    );

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        activate(tab.dataset.serviceTab ?? "telephony");
      });
    });

    function activate(slug: string | null) {
      tabs.forEach((tab) => {
        tab.setAttribute("aria-pressed", String(tab.dataset.serviceTab === slug));
      });

      panels.forEach((panel) => {
        panel.classList.toggle("is-active", panel.dataset.servicePanel === slug);
      });
    }
  });
</script>
