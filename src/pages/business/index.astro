---
import BaseLayout from "@layouts/BaseLayout.astro";
import BusinessCalculator from "@components/sections/BusinessCalculator.astro";
import { getAbsoluteUrl, getPhoneHref, getSitePath, SITE } from "@config/site";
import {
  businessCalculatorConfigs,
  type BusinessCalculatorConfig
} from "@lib/business/calculator-ui";
import { businessProofStrip, businessSegments, businessServices } from "@lib/business/content";
import type { JsonLdObject } from "@lib/seo/schema";
import "@styles/business-page.css";

type CalculatorTab = {
  slug: string;
  title: string;
  navTitle?: string;
  summary: string;
  options: string[];
  configs?: BusinessCalculatorConfig[];
};

const requestPath = "/business/request/";
const legalRequestPath = `${requestPath}?segment=legal`;
const budgetRequestPath = `${requestPath}?segment=b2g`;
const businessPhoneHref = getPhoneHref(SITE.businessPhone);
const budgetPhoneHref = getPhoneHref(SITE.budgetPhone);
const businessJobs = [
  {
    title: "Подключить офис или точку",
    text: "Клиенту важно быстро понять техническую возможность, срок и контакт менеджера."
  },
  {
    title: "Переехать без потери связи",
    text: "При переносе услуги ключевые данные - новый адрес, желаемая дата и действующие услуги."
  },
  {
    title: "Уйти от плохого качества",
    text: "Снимаем тревогу резервными магистралями, поддержкой 24/7 и прямым контактом."
  },
  {
    title: "Не ошибиться с оплатой",
    text: "Показываем путь к оплате и объясняем, что тариф можно изменить через менеджера."
  }
];
const businessFaq = [
  {
    question: "Как быстро происходит подключение?",
    answer:
      "Типовой ориентир для стандартного подключения - 1-3 рабочих дня с момента оплаты счёта, если по адресу есть техническая возможность."
  },
  {
    question: "Можно ли сменить тариф после подключения?",
    answer:
      "Да, тариф можно изменить в любой момент через менеджера. На сайте лучше оставить заявку или позвонить в коммерческий отдел."
  },
  {
    question: "Как оплачивать услуги?",
    answer:
      "В начале месяца на почту приходят счета. Оплату нужно провести до 1 числа следующего месяца, чтобы не рисковать блокировкой услуги."
  }
];
const internetOfficeProfiles = [
  {
    title: "Малый офис",
    seats: "2-5 рабочих мест",
    speed: "10-20 Мбит/с",
    summary: "Для небольшой команды, базовой телефонии, почты, мессенджеров и рабочих сервисов.",
    configuration: "Малый офис: 2-5 рабочих мест, ориентир скорости 10-20 Мбит/с."
  },
  {
    title: "Средний офис",
    seats: "10-15 рабочих мест",
    speed: "30-50 Мбит/с",
    summary: "Для офиса с общими файлами, CRM, видеозвонками и несколькими активными сервисами.",
    configuration: "Средний офис: 10-15 рабочих мест, ориентир скорости 30-50 Мбит/с."
  },
  {
    title: "Крупный офис",
    seats: "20 и более рабочих мест",
    speed: "70-100 Мбит/с",
    summary: "Для большого офиса, активных видеоконференций, облачных систем и резервирования.",
    configuration: "Крупный офис: 20 и более рабочих мест, ориентир скорости 70-100 Мбит/с."
  }
];

const calculatorTabs: CalculatorTab[] = [
  {
    slug: "internet",
    title: "Интернет",
    summary: "Корпоративный доступ в интернет для офиса, магазина, склада или точки обслуживания.",
    options: ["скорость канала", "статические IP", "резервный канал", "настройка маршрутизатора"],
    configs: [businessCalculatorConfigs.internet]
  },
  {
    slug: "telephony",
    title: "Телефония",
    summary: "IP-телефония, внутризоновая, междугородная и международная связь.",
    options: ["SIP-порты", "городские номера", "внешние линии", "ВАТС", "направления связи"],
    configs: [
      businessCalculatorConfigs.telephony,
      businessCalculatorConfigs.telephony_intrazone,
      businessCalculatorConfigs.telephony_long_distance,
      businessCalculatorConfigs.telephony_international,
      businessCalculatorConfigs.telephony_services
    ]
  },
  {
    slug: "cctv",
    title: "Видеонаблюдение",
    navTitle: "Камеры",
    summary: "Камеры, облачный архив, оборудование и монтаж для офисов, складов и торговых точек.",
    options: ["количество камер", "глубина архива", "поставка камер", "монтаж"],
    configs: [businessCalculatorConfigs.cctv]
  },
  {
    slug: "colocation",
    title: "Размещение",
    summary: "Размещение серверного оборудования в ЦОД Kubtel с питанием и связностью.",
    options: ["юниты", "питание", "порт", "IPv4", "IPMI", "удалённые работы"],
    configs: [businessCalculatorConfigs.colocation]
  },
  {
    slug: "wifi-auth",
    title: "Hot-spot",
    summary: "Гостевой Wi-Fi с авторизацией посетителей для публичных точек.",
    options: ["тариф", "количество площадок", "SMS-авторизация", "брендированная страница"],
    configs: [businessCalculatorConfigs.wifi_auth]
  },
  {
    slug: "vps",
    title: "Виртуальный сервер",
    navTitle: "VPS",
    summary: "CPU, RAM, диски, IP-адреса и резервное копирование.",
    options: ["CPU", "RAM", "SSD/HDD", "IPv4", "резервное копирование", "DDoS-защита"],
    configs: [businessCalculatorConfigs.vps]
  },
  {
    slug: "vdi",
    title: "Рабочие места",
    navTitle: "VDI",
    summary: "Виртуальные рабочие места для сотрудников с профилем ресурсов и backup.",
    options: ["количество мест", "профиль ресурсов", "резервное копирование"],
    configs: [businessCalculatorConfigs.vdi]
  }
];

function getBusinessEntryHref(slug: string) {
  return `/business/${slug}/`;
}

const pageSchema: JsonLdObject = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${getAbsoluteUrl("/business/")}#business-services`,
  name: "Kubtel для бизнеса",
  serviceType: "Телеком-услуги для бизнеса",
  areaServed: {
    "@type": "AdministrativeArea",
    name: "Краснодар и Краснодарский край"
  },
  provider: {
    "@type": "Organization",
    name: "Kubtel",
    url: getAbsoluteUrl("/")
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "B2B-услуги Kubtel",
    itemListElement: businessServices.map((service, index) => ({
      "@type": "Offer",
      position: index + 1,
      name: service.title,
      url: getAbsoluteUrl(getBusinessEntryHref(service.slug))
    }))
  }
};
---

<BaseLayout
  title="Kubtel для бизнеса"
  description="Услуги связи Kubtel для бизнеса: быстрое подключение офиса, калькуляторы, прямой контакт коммерческого отдела, доступ в ЦОД и оплата услуг."
  canonicalPath="/business/"
  schema={pageSchema}
>
  <div class="business-page">
    <section class="business-compact-hero section-pad">
      <div>
        <p class="eyebrow">Подключить интернет без очереди</p>
        <h1>Услуги связи для бизнеса</h1>
        <p>
          Интернет, телефония, Hot-spot, видеонаблюдение, размещение оборудования и виртуальные
          серверы. Сайт помогает быстро выбрать услугу, получить ориентир по расчёту и связаться с
          менеджером без лишних кругов.
        </p>
      </div>
      <div class="business-quick-actions" aria-label="Быстрые действия">
        <a class="card-action" href={getSitePath(`${legalRequestPath}&service=connection-request`)}>
          Оставить заявку
        </a>
        <a class="business-link" href="#organization-routes">Выбрать отдел</a>
        <a class="business-link" href={getSitePath("/business/datacenter-access/")}>
          Заявка на посещение ЦОД
        </a>
        <a class="business-link" href={SITE.paymentUrl} target="_blank" rel="noopener noreferrer">
          Оплатить услуги
        </a>
      </div>
    </section>

    <section
      class="section-pad business-routing-section"
      id="organization-routes"
      aria-labelledby="organization-routes-title"
    >
      <div class="section-heading">
        <p class="eyebrow">Два отдельных маршрута</p>
        <h2 id="organization-routes-title">Выберите тип организации</h2>
        <p>
          Заявка сразу попадёт нужным специалистам. Для юридических лиц и бюджетных организаций
          действуют разные адреса и телефоны.
        </p>
      </div>

      <div class="business-routing-grid">
        <article class="business-routing-card is-legal" aria-labelledby="legal-route-title">
          <div class="business-routing-card__header">
            <span class="business-routing-number" aria-hidden="true">01</span>
            <div>
              <p class="eyebrow">Безналичный расчёт</p>
              <h3 id="legal-route-title">Для юридических лиц</h3>
            </div>
          </div>
          <p class="business-routing-hint">
            Юридические лица оплачивают услуги по безналичному расчёту. По всем вопросам
            (подключение, документы, оплата, акт сверки и т.д.) обращайтесь сюда.
          </p>
          <div class="business-routing-contacts" aria-label="Контакты для юридических лиц">
            <a href={`mailto:${SITE.businessEmail}`}>{SITE.businessEmail}</a>
            <a href={businessPhoneHref}>{SITE.businessPhone}</a>
          </div>
          <a class="card-action" href={getSitePath(legalRequestPath)}>
            Оставить заявку для юрлица
          </a>
        </article>

        <article class="business-routing-card is-budget" aria-labelledby="budget-route-title">
          <div class="business-routing-card__header">
            <span class="business-routing-number" aria-hidden="true">02</span>
            <div>
              <p class="eyebrow">Отдельный сектор</p>
              <h3 id="budget-route-title">Для бюджетных организаций</h3>
            </div>
          </div>
          <p class="business-routing-hint">
            Если вы бюджетная организация — отправляйте заявку на подключение, запрос документов или
            любой другой вопрос на {SITE.budgetEmail} или звоните по телефону {SITE.budgetPhone}.
          </p>
          <div class="business-routing-contacts" aria-label="Контакты для бюджетных организаций">
            <a href={`mailto:${SITE.budgetEmail}`}>{SITE.budgetEmail}</a>
            <a href={budgetPhoneHref}>{SITE.budgetPhone}</a>
          </div>
          <a class="card-action" href={getSitePath(budgetRequestPath)}>
            Оставить заявку для бюджетной организации
          </a>
        </article>
      </div>
    </section>

    <section class="section-pad business-jobs-section" aria-label="Задачи клиентов бизнеса">
      <div class="business-proof-strip">
        {
          businessProofStrip.map((item) => (
            <span>
              <strong>{item.label}</strong>
              {item.value}
            </span>
          ))
        }
      </div>
      <div class="business-jobs-grid">
        {
          businessJobs.map((job) => (
            <article class="business-job-card">
              <h2>{job.title}</h2>
              <p>{job.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section-pad business-service-workspace" id="business-calculators">
      <div class="section-heading">
        <p class="eyebrow">Услуги и калькуляторы</p>
        <h2>Информация, расчёт и заявка</h2>
        <p>
          По каждой основной услуге доступен калькулятор и кнопка «Подключить» с передачей выбранной
          конфигурации в заявку.
        </p>
      </div>

      <div class="business-service-tabs" data-business-service-tabs>
        <nav class="business-service-list" aria-label="Услуги для бизнеса">
          {
            calculatorTabs.map((item, index) => (
              <button
                class="business-service-row"
                type="button"
                data-service-tab={item.slug}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{item.navTitle ?? item.title}</strong>
                <small>Калькулятор</small>
                <p>{item.summary}</p>
              </button>
            ))
          }
        </nav>

        <div class="business-service-panel" aria-live="polite">
          {
            calculatorTabs.map((item, index) => (
              <article
                class:list={["business-service-panel-item", { "is-active": index === 0 }]}
                data-service-panel={item.slug}
              >
                <div class="business-service-info">
                  <span class="service-category">Информация</span>
                  <h3>{item.title}</h3>
                  <p>{item.summary}</p>
                  <ul class="business-mini-list">
                    {item.options.map((option) => (
                      <li>{option}</li>
                    ))}
                  </ul>
                </div>
                <div class="business-calculator-stack">
                  {item.slug === "internet" ? (
                    <section
                      class="office-profile-panel"
                      aria-label="Подбор интернета по размеру офиса"
                    >
                      <div class="section-heading is-tight">
                        <p class="eyebrow">Интернет в офис</p>
                        <h3>Выберите размер офиса</h3>
                        <p>
                          Ориентиры по скорости помогают быстро начать заявку. Финальную полосу и
                          техническую возможность менеджер подтвердит после проверки адреса.
                        </p>
                      </div>
                      <div class="office-profile-grid">
                        {internetOfficeProfiles.map((profile) => (
                          <article class="office-profile-card">
                            <span>{profile.seats}</span>
                            <h4>{profile.title}</h4>
                            <strong>{profile.speed}</strong>
                            <p>{profile.summary}</p>
                            <a
                              class="card-action"
                              href={getSitePath(
                                `${requestPath}?service=internet&configurationSummary=${encodeURIComponent(
                                  profile.configuration
                                )}`
                              )}
                            >
                              Подключить
                            </a>
                          </article>
                        ))}
                      </div>
                    </section>
                  ) : (
                    item.configs?.map((config) => <BusinessCalculator config={config} />)
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-pad business-ops-section">
      <div class="section-heading">
        <p class="eyebrow">Заявки и оплата</p>
        <h2>Операционные действия</h2>
      </div>
      <div class="business-ops-grid">
        <a class="business-ops-card" href="#organization-routes">
          <span>Юрлица</span>
          <strong>Оплата, документы и акт сверки</strong>
          <p>Выберите тип организации, чтобы обратиться по правильному адресу без переадресаций.</p>
        </a>
        <a class="business-ops-card" href={getSitePath("/business/datacenter-access/")}>
          <span>ЦОД</span>
          <strong>Заявка на посещение ЦОД</strong>
          <p>Для планового доступа к оборудованию укажите площадку, дату, время и состав работ.</p>
        </a>
        <a
          class="business-ops-card"
          href={SITE.paymentUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Оплата</span>
          <strong>Оплатить услуги на сайте</strong>
          <p>Переход в личный кабинет для оплаты услуг юридических лиц и ИП.</p>
        </a>
      </div>
    </section>

    <section class="section-pad business-faq-section">
      <div class="section-heading">
        <p class="eyebrow">FAQ</p>
        <h2>Ответы, которые нужны до звонка</h2>
        <p>
          На сайте не даём безусловных обещаний: сроки, цены и техническая возможность
          подтверждаются после проверки адреса и действующих условий.
        </p>
      </div>
      <div class="business-faq-grid">
        {
          businessFaq.map((item) => (
            <article>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section-pad business-service-inventory" id="business-services">
      <div class="section-heading">
        <p class="eyebrow">Все направления</p>
        <h2>Сохранённый реестр бизнес-услуг</h2>
        <p>
          Помимо услуг с быстрым расчётом, в разделе остаются действующие B2B-направления, которые
          уже были описаны в структуре сайта: статические IP-адреса, заявки по ЦОД и сегментные
          решения для разных типов клиентов.
        </p>
      </div>
      <div class="business-service-rail">
        {
          businessServices.map((service, index) => (
            <a class="business-service-row" href={getSitePath(getBusinessEntryHref(service.slug))}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{service.title}</strong>
              <small>{service.category}</small>
              <p>{service.summary}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section-pad business-segments-vip">
      <div class="section-heading">
        <p class="eyebrow">Сегменты</p>
        <h2>Решения для разных типов клиентов</h2>
        <p>
          Сегментные страницы остаются доступными: малому и среднему бизнесу, операторам связи и B2G
          для государственных заказчиков.
        </p>
      </div>
      <div class="business-segment-grid">
        {
          businessSegments.map((segment) => (
            <a class="business-segment-card" href={getSitePath(`/business/${segment.slug}/`)}>
              <h3>{segment.title}</h3>
              <p>{segment.summary}</p>
              <strong>{segment.trigger}</strong>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-business-service-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-service-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-service-panel]")];

    const requestedTab = normalizeCalculatorParam(
      new URLSearchParams(window.location.search).get("calculator")
    );
    activate(
      tabs.some((tab) => tab.dataset.serviceTab === requestedTab) ? requestedTab : "internet"
    );

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        activate(tab.dataset.serviceTab ?? "internet");
      });
    });

    function activate(slug: string | null) {
      tabs.forEach((tab) => {
        tab.setAttribute("aria-pressed", String(tab.dataset.serviceTab === slug));
      });

      panels.forEach((panel) => {
        panel.classList.toggle("is-active", panel.dataset.servicePanel === slug);
      });
    }

    function normalizeCalculatorParam(value: string | null) {
      if (value === "wifi_auth") {
        return "wifi-auth";
      }

      return value;
    }
  });
</script>
