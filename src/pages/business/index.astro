<script>
  document.querySelectorAll<HTMLElement>("[data-business-service-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-service-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-service-panel]")];
    const select = root.querySelector<HTMLSelectElement>("[data-service-select]");
    const params = new URLSearchParams(window.location.search);

    const requestedTab = normalizeServiceParam(params.get("calculator") ?? params.get("service"));
    activate(
      tabs.some((tab) => tab.dataset.serviceTab === requestedTab) ? requestedTab : "colocation"
    );

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const slug = tab.dataset.serviceTab ?? "internet";
        activate(slug);
        persistSelection(slug);
      });
    });

    select?.addEventListener("change", () => {
      activate(select.value);
      persistSelection(select.value);
    });

    function activate(slug: string | null) {
      tabs.forEach((tab) => {
        tab.setAttribute("aria-pressed", String(tab.dataset.serviceTab === slug));
      });

      panels.forEach((panel) => {
        panel.classList.toggle("is-active", panel.dataset.servicePanel === slug);
      });

      if (select && slug) {
        select.value = slug;
      }
    }

    function persistSelection(slug: string) {
      const nextUrl = new URL(window.location.href);
      nextUrl.searchParams.set("calculator", slug);
      nextUrl.searchParams.delete("service");
      window.history.replaceState({}, "", nextUrl);
    }

    function normalizeServiceParam(value: string | null) {
      if (value === "wifi_auth") {
        return "wifi-auth";
      }

      if (value === "hotspot" || value === "hot-spot") {
        return "wifi-auth";
      }

      return value;
    }
  });
</script>
