---
import BaseLayout from "@layouts/BaseLayout.astro";
import BusinessCalculator from "@components/sections/BusinessCalculator.astro";
import PromoImage from "@components/ui/PromoImage.astro";
import { getAbsoluteUrl, getPhoneHref, getSitePath, SITE } from "@config/site";
import { getBusinessCalculatorConfig } from "@lib/business/calculator-ui";
import {
  businessSegments,
  businessServices,
  getBusinessSegment,
  getBusinessSegmentPath,
  getBusinessSegmentRouteSlug,
  getBusinessService,
  getRelatedBusinessServices,
  type BusinessSegment,
  type BusinessService
} from "@lib/business/content";
import type { JsonLdObject } from "@lib/seo/schema";
import { getBusinessVisual } from "@lib/visuals";
import "@styles/business-page.css";

type PageEntry =
  | { kind: "service"; entry: BusinessService }
  | { kind: "segment"; entry: BusinessSegment; pathSlug: string };

export function getStaticPaths() {
  return [
    ...businessServices
      .filter((entry) => entry.slug !== "datacenter-access")
      .map((entry) => ({
        params: { slug: entry.slug },
        props: { kind: "service", entry } satisfies PageEntry
      })),
    ...businessSegments.flatMap((entry) => {
      const pathSlugs = [entry.slug, getBusinessSegmentRouteSlug(entry.slug)].filter(
        (slug, index, all) => all.indexOf(slug) === index
      );

      return pathSlugs.map((pathSlug) => ({
        params: { slug: pathSlug },
        props: { kind: "segment", entry, pathSlug } satisfies PageEntry
      }));
    })
  ];
}

const pageEntry = isPageEntry(Astro.props) ? Astro.props : getPageEntry(Astro.params.slug);

if (!pageEntry) {
  return Astro.redirect(getSitePath("/business/"), 302);
}

const { kind, entry } = pageEntry;
const isService = kind === "service";
const title = isService ? entry.seoTitle : entry.seoTitle;
const description = isService ? entry.seoDescription : entry.seoDescription;
const routeSlug = isService
  ? entry.slug
  : pageEntry.pathSlug || getBusinessSegmentRouteSlug(entry.slug);
const canonicalPath = `/business/${routeSlug}/`;
const relatedServices = isService
  ? getRelatedBusinessServices(entry.relatedServices)
  : getRelatedBusinessServices(entry.serviceSlugs);
const calculatorConfig = isService ? getBusinessCalculatorConfig(entry.slug) : undefined;
const visual = getBusinessVisual(entry.slug);
const isGovernmentSegment = !isService && entry.slug === "b2g";
const segmentServices = !isService ? getRelatedBusinessServices(entry.serviceSlugs) : [];
const segmentCalculatorService = segmentServices.find((service) =>
  getBusinessCalculatorConfig(service.slug)
);
const segmentCalculatorConfig = segmentCalculatorService
  ? getBusinessCalculatorConfig(segmentCalculatorService.slug)
  : undefined;
const b2gEmail = SITE.budgetEmail;
const b2gPhoneDisplay = SITE.budgetPhone;
const b2gPhoneHref = getPhoneHref(SITE.budgetPhone);
const b2gRequestPath = `/business/request/?segment=b2g&service=b2g-consultation&configurationSummary=${encodeURIComponent(
  "Прошу заказать обратный звонок сотрудника сектора B2G."
)}`;
const b2gMailHref = `mailto:${b2gEmail}?subject=${encodeURIComponent(
  "B2G: запрос государственного заказчика"
)}&body=${encodeURIComponent("Здравствуйте. Просим связаться по вопросу услуг связи для государственного заказчика.")}`;
const segmentRequestPath = `/business/request/?segment=${routeSlug}`;
const segmentContactEmail = isGovernmentSegment ? SITE.budgetEmail : SITE.businessEmail;
const segmentContactPhone = isGovernmentSegment ? SITE.budgetPhone : SITE.businessPhone;
const segmentContactHref = getPhoneHref(segmentContactPhone);
const segmentTariffLabel = isGovernmentSegment
  ? "Стоимость формируется по закупочной процедуре и техническому заданию"
  : routeSlug === "b2o"
    ? "Партнёрский расчёт по площадке, портам и ёмкости"
    : "Индивидуальный тариф по адресу и составу услуг";
const b2gLaws = [
  'Федеральный закон "О контрактной системе в сфере закупок товаров, работ, услуг для обеспечения государственных и муниципальных нужд" от 05.04.2013 N 44-ФЗ',
  'Федеральный закон "О закупках товаров, работ, услуг отдельными видами юридических лиц" от 18.07.2011 N 223-ФЗ'
];
const b2gPlatforms = [
  "АГЗ РТ",
  "Электронная торговая площадка «Фабрикант»",
  "АО «РАД»",
  "РТС-тендер",
  "ЭТП ТЭК-Торг",
  "АО «Сбербанк-АСТ»",
  "РОСЭЛТОРГ (АО «ЕЭТП»)",
  "ЭТП Газпромбанк",
  "АСТ ГОЗ",
  "ЕАТ.РФ («Березка»)"
];
const b2gServiceScenarios = [
  {
    title: "Интернет для учреждения",
    text: "Подключение, перенос услуги при переезде, увеличение скорости и проверка технической возможности."
  },
  {
    title: "Резервирование интернета",
    text: "Обсуждаем резервный канал для критичных объектов, если это возможно технически и бюджетно."
  },
  {
    title: "Телефония и ВАТС",
    text: "Помогаем разобрать местную и IP-телефонию, количество разговоров, номера, оборудование и запись разговоров."
  },
  {
    title: "Hot-spot и ЛВС",
    text: "Можно обсудить публичный Wi-Fi с авторизацией, оборудование, настройку и организацию рабочих мест."
  }
];
const b2gFaq = [
  {
    question: "Работает ли КУБАНЬ-ТЕЛЕКОМ по 44-ФЗ и 223-ФЗ?",
    answer:
      "Да. Компания оказывает услуги связи государственным заказчикам в рамках 44-ФЗ и 223-ФЗ, зарегистрирована в ЕИС и аккредитована на федеральных ЭТП."
  },
  {
    question: "Можно ли получить лицензии?",
    answer:
      "Да, лицензии и реквизиты нужно запрашивать у сотрудника сектора B2G. Перед публикацией номера лицензий и реквизиты требуют отдельной сверки."
  },
  {
    question: "Как быстро будет обратная связь?",
    answer:
      "Заявка с сайта маркируется как B2G; целевой ориентир первичной обратной связи - до 30 минут в рабочее время."
  }
];
const telephonyGuides = [
  "Если нет готового ТЗ, опишите задачу обычными словами: новый офис, модернизация старой связи, колл-центр или снижение расходов на междугородную связь.",
  "В калькуляторе внешние линии названы как одновременные внешние разговоры, а SIP-порты - как сотрудники или устройства.",
  "Для сложных схем менеджер уточнит оборудование, населённый пункт, текущего оператора и требования к записи разговоров."
];
const entryRequestPath = isGovernmentSegment
  ? b2gRequestPath
  : !isService
    ? segmentRequestPath
    : getBusinessEntryHref(entry.slug);

const segmentRouteItems = [
  {
    slug: "b2b",
    label: "B2B",
    title: "Для бизнеса",
    summary: "Офисы, магазины и точки обслуживания",
    href: getBusinessSegmentPath("b2b")
  },
  {
    slug: "b2g",
    label: "B2G",
    title: "Для государства",
    summary: "Закупки, документы и связь учреждений",
    href: getBusinessSegmentPath("b2g")
  },
  {
    slug: "b2o",
    label: "B2O",
    title: "Для операторов",
    summary: "ЦОД, связность и партнёрские условия",
    href: getBusinessSegmentPath("b2o")
  }
];

function getSegmentServiceHref(service: BusinessService): string {
  return getBusinessCalculatorConfig(service.slug)
    ? `/business/?calculator=${service.slug}#business-calculators`
    : getBusinessEntryHref(service.slug);
}

function getSegmentServiceCta(service: BusinessService): string {
  return getBusinessCalculatorConfig(service.slug) ? "Открыть калькулятор" : service.ctaLabel;
}

function getBusinessEntryHref(slug: string) {
  if (slug === "smb" || slug === "b2b") {
    return "/business/request/?segment=b2b";
  }

  if (slug === "operators" || slug === "b2o") {
    return "/business/request/?segment=b2o";
  }

  if (slug === "b2g") {
    return "/business/request/?segment=b2g";
  }

  if (slug === "datacenter-access") {
    return "/business/datacenter-access/";
  }

  if (slug === "internet" || slug === "static-ip") {
    return `/business/request/?service=${slug}`;
  }

  if (slug === "telephony") {
    return "/business/?calculator=telephony#business-calculators";
  }

  return `/business/?calculator=${slug}#business-calculators`;
}

function getPageEntry(slug: string | undefined): PageEntry | undefined {
  if (!slug) {
    return undefined;
  }

  const service = getBusinessService(slug);
  if (service) {
    return { kind: "service", entry: service };
  }

  const segment = getBusinessSegment(slug);
  if (segment) {
    return { kind: "segment", entry: segment, pathSlug: getBusinessSegmentRouteSlug(slug) };
  }

  return undefined;
}

function isPageEntry(value: unknown): value is PageEntry {
  return (
    typeof value === "object" &&
    value !== null &&
    "kind" in value &&
    "entry" in value &&
    ((value as PageEntry).kind === "service" || (value as PageEntry).kind === "segment")
  );
}

const pageSchema: JsonLdObject = isService
  ? {
      "@context": "https://schema.org",
      "@type": "Service",
      "@id": `${getAbsoluteUrl(canonicalPath)}#service`,
      name: entry.title,
      description: entry.summary,
      serviceType: entry.category,
      provider: {
        "@type": "Organization",
        name: "Kubtel",
        url: getAbsoluteUrl("/")
      },
      areaServed: {
        "@type": "AdministrativeArea",
        name: "Краснодар и Краснодарский край"
      }
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": `${getAbsoluteUrl(canonicalPath)}#segment`,
      name: entry.title,
      description: entry.summary
    };
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  schema={pageSchema}
>
  <div class="business-page">
    <section class="page-intro section-pad business-page-intro visual-intro">
      <div>
        <p class="eyebrow">
          {isService ? "Услуга для организаций" : `${routeSlug.toUpperCase()} · отдельный маршрут`}
        </p>
        <h1>{entry.title}</h1>
        <p>{isService ? entry.businessBenefit : entry.summary}</p>
        <div class="business-actions">
          <a class="card-action" href={getSitePath(entryRequestPath)}>
            {isService ? entry.ctaLabel : entry.ctaLabel}
          </a>
          <a class="business-link" href={getSitePath("/business/")}>Все бизнес-услуги</a>
        </div>
      </div>
      <PromoImage visual={visual} class="is-page-intro" loading="eager" />
    </section>

    {
      isService ? (
        <section class="section-pad business-detail-grid">
          <article class="business-detail-card">
            <p class="eyebrow">Что входит</p>
            <h2>Параметры для расчёта</h2>
            <ul class="business-mini-list">
              {entry.options.map((option) => (
                <li>{option}</li>
              ))}
            </ul>
          </article>
          <article class="business-detail-card">
            <p class="eyebrow">Конфигуратор</p>
            <h2>Что спросим в&nbsp;заявке</h2>
            <ul class="business-mini-list">
              {entry.calculatorFields.map((field) => (
                <li>{field}</li>
              ))}
            </ul>
          </article>
          <article class="business-detail-card">
            <p class="eyebrow">Доказательства</p>
            <h2>Статусы фактов</h2>
            <div class="business-proof-list">
              {entry.proofPoints.map((proof) => (
                <span>
                  <strong>{proof.label}</strong>
                  {proof.value}
                  <small>{proof.status}</small>
                </span>
              ))}
            </div>
          </article>
        </section>
      ) : (
        <section class="section-pad business-detail-grid">
          <article class="business-detail-card">
            <p class="eyebrow">Боль</p>
            <h2>Что закрываем</h2>
            <p>{entry.pain}</p>
          </article>
          <article class="business-detail-card">
            <p class="eyebrow">Триггер</p>
            <h2>Когда обращаться</h2>
            <p>{entry.trigger}</p>
          </article>
          <article class="business-detail-card">
            <p class="eyebrow">Поля заявки</p>
            <h2>Что уточним</h2>
            <ul class="business-mini-list">
              {entry.fields.map((field) => (
                <li>{field}</li>
              ))}
            </ul>
          </article>
        </section>
      )
    }

    {
      !isService && (
        <>
          <section
            class="section-pad business-segment-switcher-section"
            aria-label="Разделы для организаций"
          >
            <nav class="business-segment-switcher">
              {segmentRouteItems.map((item) => (
                <a
                  class:list={[
                    "business-segment-switcher__item",
                    { "is-active": item.slug === routeSlug }
                  ]}
                  href={getSitePath(item.href)}
                  aria-current={item.slug === routeSlug ? "page" : undefined}
                >
                  <span>{item.label}</span>
                  <strong>{item.title}</strong>
                  <small>{item.summary}</small>
                </a>
              ))}
            </nav>
          </section>

          <section class="section-pad business-segment-workspace" id="segment-services">
            <div class="section-heading">
              <p class="eyebrow">Маршрут {routeSlug.toUpperCase()}</p>
              <h2>Услуги, расчёт и заявка в одном разделе</h2>
              <p>
                Начните с нужной услуги, откройте параметры и передайте готовую конфигурацию
                менеджеру. Если точный состав пока неизвестен, оставьте короткую заявку — поможем
                собрать решение.
              </p>
            </div>

            <div class="business-card-grid business-segment-service-grid">
              {segmentServices.map((service) => (
                <article class="business-card">
                  <span class="service-category">{service.category}</span>
                  <h3>{service.title}</h3>
                  <p>{service.summary}</p>
                  <ul class="business-mini-list">
                    {service.options.slice(0, 4).map((option) => (
                      <li>{option}</li>
                    ))}
                  </ul>
                  <a class="card-action" href={getSitePath(getSegmentServiceHref(service))}>
                    {getSegmentServiceCta(service)}
                  </a>
                </article>
              ))}
            </div>

            <div class="business-segment-utility-grid">
              <article class="business-detail-card">
                <p class="eyebrow">Тарифы и расчёт</p>
                <h3>Состав под вашу задачу</h3>
                <p>{segmentTariffLabel}.</p>
                <a
                  class="business-link"
                  href={getSitePath(
                    segmentCalculatorService
                      ? getSegmentServiceHref(segmentCalculatorService)
                      : segmentRequestPath
                  )}
                >
                  {segmentCalculatorService ? "Перейти к быстрому расчёту" : "Запросить расчёт"}
                </a>
              </article>
              <article class="business-detail-card">
                <p class="eyebrow">Контакты</p>
                <h3>Прямой канал для {routeSlug.toUpperCase()}</h3>
                <p>Сообщите адрес, площадку или задачу — специалист продолжит с нужного места.</p>
                <div class="business-segment-contact-links">
                  <a class="business-phone-card" href={segmentContactHref}>
                    {segmentContactPhone}
                  </a>
                  <a class="business-link" href={`mailto:${segmentContactEmail}`}>
                    {segmentContactEmail}
                  </a>
                </div>
              </article>
              <article class="business-detail-card">
                <p class="eyebrow">Заявка</p>
                <h3>Ответ без лишней переадресации</h3>
                <p>Форма уже знает выбранный сегмент и передаст обращение ответственному отделу.</p>
                <a class="card-action" href={getSitePath(segmentRequestPath)}>
                  Оставить заявку
                </a>
              </article>
            </div>
          </section>

          {segmentCalculatorConfig && (
            <BusinessCalculator config={segmentCalculatorConfig} requestPath={segmentRequestPath} />
          )}
        </>
      )
    }

    {
      isGovernmentSegment && (
        <section class="section-pad b2g-procurement-section" id="b2g">
          <div class="section-heading">
            <p class="eyebrow">B2G</p>
            <h2>Для государственных заказчиков</h2>
            <p>
              КУБАНЬ-ТЕЛЕКОМ оказывает услуги связи юридическим лицам - государственным заказчикам:
              федеральным и муниципальным бюджетным учреждениям.
            </p>
          </div>

          <div class="b2g-framework-grid">
            <article class="business-detail-card b2g-law-card">
              <p class="eyebrow">Закупочная база</p>
              <h3>Работаем в рамках 44-ФЗ и 223-ФЗ</h3>
              <ul class="business-mini-list">
                {b2gLaws.map((law) => (
                  <li>{law}</li>
                ))}
              </ul>
            </article>

            <article class="business-detail-card b2g-platform-card">
              <p class="eyebrow">ЕИС и ЭТП</p>
              <h3>Аккредитация на федеральных площадках</h3>
              <p>
                КУБАНЬ-ТЕЛЕКОМ зарегистрировано в ЕИС, аккредитовано на 10 федеральных ЭТП и
                принимает участие в процедурах закупки товаров, работ и услуг на ЭТП и вне торговых
                площадок.
              </p>
              <div class="b2g-platform-list" aria-label="Федеральные электронные торговые площадки">
                {b2gPlatforms.map((platform) => (
                  <span>{platform}</span>
                ))}
              </div>
            </article>
          </div>

          <div class="section-heading is-tight">
            <p class="eyebrow">Услуги</p>
            <h2>Что можно обсудить с сектором B2G</h2>
            <p>
              Для государственных заказчиков не смешиваем разные бюджетные статьи в одно обещание.
              На сайте показываем направления, а конкретное решение, документы и формулировки
              уточняет сотрудник сектора B2G.
            </p>
          </div>
          <div class="business-card-grid b2g-service-grid">
            {b2gServiceScenarios.map((scenario) => (
              <article class="business-card">
                <span class="service-category">B2G</span>
                <h3>{scenario.title}</h3>
                <p>{scenario.text}</p>
              </article>
            ))}
          </div>

          <div class="b2g-contact-panel">
            <div>
              <p class="eyebrow">Контакты сектора B2G</p>
              <h2>Связаться с сотрудником</h2>
              <p>
                Можно написать на электронный адрес, позвонить напрямую или заказать обратный звонок
                через стандартную форму заявки с согласием на обработку персональных данных.
              </p>
            </div>
            <div class="b2g-contact-actions" aria-label="Способы связи с сектором B2G">
              <a class="card-action" href={b2gMailHref}>
                Написать на {b2gEmail}
              </a>
              <a class="business-phone-card" href={b2gPhoneHref}>
                Позвонить {b2gPhoneDisplay}
              </a>
              <a class="business-link" href={getSitePath(b2gRequestPath)}>
                Заказать обратный звонок
              </a>
            </div>
          </div>

          <div class="business-faq-grid">
            {b2gFaq.map((item) => (
              <article>
                <h3>{item.question}</h3>
                <p>{item.answer}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      isService && entry.slug === "telephony" && (
        <section class="section-pad telephony-service-options">
          <div class="section-heading">
            <p class="eyebrow">Телефония</p>
            <h2>Четыре услуги, которые считаются в калькуляторе</h2>
            <p>
              Телефония не сводится к одному ползунку: отдельно считаются SIP-порты, городские
              номера, одновременные внешние разговоры и функции виртуальной АТС.
            </p>
          </div>
          <div class="business-card-grid">
            {[
              "Сотрудники и устройства",
              "Городские номера",
              "Одновременные внешние разговоры",
              "Виртуальная АТС, автооператор и запись"
            ].map((item) => (
              <article class="business-card">
                <span class="service-category">Калькулятор</span>
                <h3>{item}</h3>
                <p>Позиция попадает в итоговую конфигурацию и передаётся менеджеру в заявке.</p>
              </article>
            ))}
          </div>
          <div class="telephony-guide-panel">
            <h3>Если нет готового ТЗ</h3>
            <ul class="business-mini-list">
              {telephonyGuides.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <a
              class="card-action"
              href={getSitePath("/business/?calculator=telephony#business-calculators")}
            >
              Открыть калькулятор телефонии
            </a>
          </div>
        </section>
      )
    }

    {calculatorConfig && <BusinessCalculator config={calculatorConfig} />}

    <section class="section-pad">
      <div class="section-heading">
        <p class="eyebrow">Связанные услуги</p>
        <h2>Собрать решение без разрозненных заявок</h2>
      </div>
      <div class="business-card-grid">
        {
          relatedServices.map((service) => (
            <article class="business-card">
              <span class="service-category">{service.category}</span>
              <h3>{service.title}</h3>
              <p>{service.summary}</p>
              <a class="card-action" href={getSitePath(getBusinessEntryHref(service.slug))}>
                {service.ctaLabel}
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
