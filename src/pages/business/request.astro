---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getPhoneHref, getSitePath, SITE } from "@config/site";
import { businessServices, getBusinessSegment, getBusinessService } from "@lib/business/content";
import { handleBusinessLeadFormPost } from "@lib/leads/form-handlers";
import "@styles/business-page.css";

const isStaticPreview = import.meta.env.PUBLIC_STATIC_PREVIEW === "true";
export const prerender = false;

const selectedService = Astro.url.searchParams.get("service") ?? "";
const rawSelectedSegment = Astro.url.searchParams.get("segment") ?? "";
const selectedSegment = rawSelectedSegment === "government" ? "b2g" : rawSelectedSegment;
const selectedConfiguration = Astro.url.searchParams.get("configurationSummary") ?? "";
const selectedOfficeProfile = Astro.url.searchParams.get("officeProfile") ?? "";
const selectedMonthlyEstimate = Astro.url.searchParams.get("monthlyEstimate") ?? "";
const selectedOneTimeEstimate = Astro.url.searchParams.get("oneTimeEstimate") ?? "";
const service = selectedService ? getBusinessService(selectedService) : undefined;
const segment = selectedSegment ? getBusinessSegment(selectedSegment) : undefined;
const inquiryOptions = [
  { slug: "connection-request", title: "Подключение услуги" },
  { slug: "documents-payment", title: "Документы, оплата или акт сверки" },
  { slug: "callback", title: "Обратный звонок" },
  { slug: "other", title: "Другой вопрос" }
];
const b2gConsultationOption = {
  slug: "b2g-consultation",
  title: "Закупка или B2G-консультация"
};
const selectedInquiry = [...inquiryOptions, b2gConsultationOption].find(
  (option) => option.slug === selectedService
);
const contextTitle = service?.title ?? selectedInquiry?.title ?? segment?.title ?? "Ваше обращение";
const isBudgetRequest = selectedSegment === "b2g" || selectedService === "b2g-consultation";
const pageTitle = isBudgetRequest
  ? "Обращение для бюджетной организации"
  : "Обращение для юридического лица";
const introText = isBudgetRequest
  ? "Оставьте заявку на подключение, запрос документов, обратный звонок или задайте любой другой вопрос. Обращение получит сектор по работе с бюджетными организациями."
  : "Юридические лица оплачивают услуги по безналичному расчёту. Здесь можно оставить заявку на подключение, запросить документы, оплату или акт сверки, заказать звонок и задать любой другой вопрос.";
const summaryText = isBudgetRequest
  ? `Заявка будет направлена на ${SITE.budgetEmail}. Для прямой связи используйте только контакты бюджетного сектора.`
  : `Заявка будет направлена на ${SITE.businessEmail}. Для прямой связи используйте контакты отдела по работе с юридическими лицами.`;
const formStartedAt = Date.now().toString();
const recipientEmail = isBudgetRequest ? SITE.budgetEmail : SITE.businessEmail;
const phoneDisplay = isBudgetRequest ? SITE.budgetPhone : SITE.businessPhone;
const phoneHref = getPhoneHref(phoneDisplay);
const actionResult = isStaticPreview
  ? undefined
  : Astro.request.method === "POST"
    ? await handleBusinessLeadFormPost(await Astro.request.formData(), Astro.request)
    : undefined;
const actionData = actionResult?.data;
const actionError = actionResult?.error;
---

<BaseLayout
  title={pageTitle}
  description="Короткая B2B/B2G-заявка Kubtel: контакт, услуга, адрес или учреждение, предпочтительный канал связи и комментарий."
  canonicalPath="/business/request/"
  pageType="ContactPage"
>
  <div class="business-page">
    <section class="business-request-hero section-pad">
      <div>
        <p class="eyebrow" data-request-eyebrow>
          {isBudgetRequest ? "Бюджетный сектор" : "Юрлица"}
        </p>
        <h1 data-request-title>{pageTitle}</h1>
        <p data-request-intro>{introText}</p>
      </div>
      <aside class="business-callout request-contact-callout">
        <span data-request-contact-label>
          {isBudgetRequest ? "Контакты бюджетного сектора" : "Контакты для юридических лиц"}
        </span>
        <a href={phoneHref} data-request-phone>{phoneDisplay}</a>
        <a href={`mailto:${recipientEmail}`} data-request-email>{recipientEmail}</a>
      </aside>
    </section>

    <section class="section-pad business-request-layout is-compact" id="business-request">
      <form
        class="business-request-form"
        method="post"
        action={isStaticPreview ? "#business-request" : `${Astro.url.pathname}${Astro.url.search}`}
        data-business-request-form
        data-static-preview={isStaticPreview ? "true" : undefined}
      >
        {
          actionData && (
            <div
              class="form-status is-success"
              id="business-form-status"
              role="status"
              tabindex="-1"
            >
              <strong>{actionData.message}</strong>
              <span>Номер заявки: {actionData.leadId}</span>
            </div>
          )
        }
        {
          actionError && (
            <div class="form-status is-error" id="business-form-status" role="alert" tabindex="-1">
              <strong>Заявка не отправлена</strong>
              <span>{actionError.message ?? "Проверьте поля и попробуйте ещё раз."}</span>
            </div>
          )
        }
        <input name="sourcePath" type="hidden" value={Astro.url.pathname} />
        <input name="formStartedAt" type="hidden" value={formStartedAt} />
        <input name="monthlyEstimate" type="hidden" value={selectedMonthlyEstimate} />
        <input name="oneTimeEstimate" type="hidden" value={selectedOneTimeEstimate} />
        <input name="city" type="hidden" value="" />
        <input name="segment" type="hidden" value={selectedSegment} />
        <input name="officeProfile" type="hidden" value={selectedOfficeProfile} />
        <input name="urgency" type="hidden" value={isBudgetRequest ? "asap" : "planning"} />
        <label class="visually-hidden">
          <span>Оставьте это поле пустым</span>
          <input name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>

        <fieldset class="form-group">
          <legend>Контакт</legend>
          <div class="contact-grid compact-business-grid">
            <label>
              {isBudgetRequest ? "Рабочий телефон *" : "Телефон *"}
              <input
                name="phone"
                type="tel"
                autocomplete="tel"
                inputmode="tel"
                maxlength="32"
                placeholder={isBudgetRequest
                  ? "+7 861 ... добавочный можно указать в комментарии"
                  : undefined}
                required
              />
            </label>
            <label>
              {isBudgetRequest ? "Учреждение" : "Компания"}
              <input
                name="companyName"
                type="text"
                autocomplete="organization"
                maxlength="160"
                placeholder={isBudgetRequest
                  ? "Название учреждения, если удобно указать"
                  : undefined}
              />
            </label>
            <label>
              {isBudgetRequest ? "Имя и отчество" : "Контактное лицо"}
              <input
                name="contactPerson"
                type="text"
                autocomplete="name"
                maxlength="120"
                required={isBudgetRequest}
              />
            </label>
            <label>
              Электронная почта
              <input name="email" type="email" autocomplete="email" maxlength="120" />
            </label>
          </div>
          <details
            class="b2g-extra-contact"
            data-b2g-extra-contact
            open={isBudgetRequest}
            hidden={!isBudgetRequest}
          >
            <summary>Дополнительно для B2G</summary>
            <div class="contact-grid compact-business-grid">
              <label>
                Мобильный телефон
                <input
                  name="mobilePhone"
                  type="tel"
                  autocomplete="tel"
                  inputmode="tel"
                  maxlength="32"
                  placeholder="+7 ..."
                />
              </label>
            </div>
            <div class="preferred-contact-group" aria-label="Предпочтительный канал связи">
              <span>Связаться удобнее</span>
              <label>
                <input
                  type="radio"
                  name="preferredContact"
                  value="рабочий телефон"
                  checked={isBudgetRequest}
                />
                по рабочему телефону
              </label>
              <label>
                <input type="radio" name="preferredContact" value="мобильный телефон" />
                по мобильному телефону
              </label>
              <label>
                <input type="radio" name="preferredContact" value="e-mail" />
                написать на e-mail
              </label>
            </div>
          </details>
        </fieldset>

        <fieldset class="form-group">
          <legend>Заявка</legend>
          <div class="contact-grid compact-business-grid">
            <label>
              Тема обращения *
              <select name="service" required>
                <option value="">Выберите тему</option>
                <optgroup label="Тип обращения">
                  {
                    [...inquiryOptions, b2gConsultationOption].map((item) => (
                      <option value={item.slug} selected={item.slug === selectedService}>
                        {item.title}
                      </option>
                    ))
                  }
                </optgroup>
                <optgroup label="Конкретная услуга">
                  {
                    businessServices.map((item) => (
                      <option value={item.slug} selected={item.slug === selectedService}>
                        {item.title}
                      </option>
                    ))
                  }
                </optgroup>
              </select>
            </label>
            <label>
              Город или адрес объекта
              <input
                name="address"
                type="text"
                autocomplete="street-address"
                maxlength="240"
                placeholder={isBudgetRequest
                  ? "Например: Краснодар, учреждение или адрес объекта"
                  : "Обязательно для заявки на подключение услуги"}
                data-request-address
              />
              <small data-request-address-hint
                >Для документов, обратного звонка и других вопросов можно не указывать.</small
              >
            </label>
          </div>
        </fieldset>

        <label class="message-field">
          Комментарий
          <textarea
            name="configurationSummary"
            rows="4"
            maxlength="1200"
            placeholder={isBudgetRequest
              ? "Например: нужна телефония, интернет, резервирование или консультация по документации"
              : "Например: нужен интернет в офис, телефония, доступ в ЦОД или удобное время звонка"}
            >{selectedConfiguration}</textarea
          >
        </label>
        <input name="message" type="hidden" value="" />
        <input name="inn" type="hidden" value="" />
        <input name="employeesOrSites" type="hidden" value="" />

        <label class="consent-line">
          <input type="checkbox" name="consent" required />
          <span>
            Согласен на обработку персональных данных для связи по заявке и ознакомлен с
            <a href={SITE.privacyUrl} target="_blank" rel="noopener noreferrer">политикой ПД</a>.
          </span>
        </label>

        <button type="submit">Отправить заявку</button>
      </form>

      <aside class="business-request-summary compact-request-summary" aria-label="Контекст заявки">
        <span class="service-category">Контекст</span>
        <h2 data-request-context-title>{contextTitle}</h2>
        <p data-request-summary>{summaryText}</p>
        <a class="business-phone-card" href={phoneHref} data-request-phone>{phoneDisplay}</a>
        <a class="business-link" href={`mailto:${recipientEmail}`} data-request-email>
          {recipientEmail}
        </a>
        <a class="business-link" href={getSitePath("/business/")}>Вернуться к услугам</a>
      </aside>
    </section>
  </div>
</BaseLayout>

<script>
  const businessForm = document.querySelector<HTMLFormElement>("[data-business-request-form]");
  const requestParams = new URLSearchParams(window.location.search);
  const requestedService = requestParams.get("service");
  const requestedSegment = requestParams.get("segment");
  const isB2GRequest =
    requestedSegment === "b2g" ||
    requestedSegment === "government" ||
    requestedService === "b2g-consultation";

  if (businessForm) {
    applyBusinessRequestContext(businessForm, requestParams, isB2GRequest);
  }

  if (businessForm?.dataset.staticPreview === "true") {
    businessForm.addEventListener("submit", (event) => {
      if (!businessForm.checkValidity()) {
        return;
      }

      event.preventDefault();
      showBusinessPreviewNotice(businessForm);
    });
  }

  function applyBusinessRequestContext(
    form: HTMLFormElement,
    params: URLSearchParams,
    isB2G: boolean
  ) {
    const requestedService = params.get("service");
    const requestedSegment = params.get("segment");
    const serviceSelect = form.querySelector<HTMLSelectElement>('select[name="service"]');
    const segmentInput = form.querySelector<HTMLInputElement>('input[name="segment"]');
    const urgencyInput = form.querySelector<HTMLInputElement>('input[name="urgency"]');
    const b2gExtra = form.querySelector<HTMLDetailsElement>("[data-b2g-extra-contact]");
    const addressInput = form.querySelector<HTMLInputElement>("[data-request-address]");

    for (const fieldName of [
      "officeProfile",
      "configurationSummary",
      "monthlyEstimate",
      "oneTimeEstimate"
    ]) {
      const requestedValue = params.get(fieldName);
      const field = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(
        `[name="${fieldName}"]`
      );

      if (requestedValue !== null && field) {
        field.value = requestedValue;
      }
    }

    if (requestedService && serviceSelect) {
      serviceSelect.value = requestedService;
    }

    updateAddressRequirement(serviceSelect, addressInput);
    serviceSelect?.addEventListener("change", () => {
      updateAddressRequirement(serviceSelect, addressInput);
      const selectedTitle = serviceSelect.selectedOptions[0]?.textContent?.trim();
      if (selectedTitle && serviceSelect.value) {
        setText("[data-request-context-title]", selectedTitle);
      }
    });

    if (requestedSegment && segmentInput) {
      segmentInput.value = requestedSegment === "government" ? "b2g" : requestedSegment;
    }

    if (isB2G && urgencyInput) {
      urgencyInput.value = "asap";
    }

    if (isB2G) {
      if (b2gExtra) {
        b2gExtra.hidden = false;
        b2gExtra.open = true;
      }

      const preferredWorkPhone = form.querySelector<HTMLInputElement>(
        'input[name="preferredContact"][value="рабочий телефон"]'
      );
      if (preferredWorkPhone) {
        preferredWorkPhone.checked = true;
      }

      setText("[data-request-eyebrow]", "Бюджетный сектор");
      setText("[data-request-title]", "Обращение для бюджетной организации");
      setText(
        "[data-request-intro]",
        "Оставьте заявку на подключение, запрос документов, обратный звонок или задайте любой другой вопрос. Обращение получит сектор по работе с бюджетными организациями."
      );
      setText("[data-request-contact-label]", "Контакты бюджетного сектора");
      setText(
        "[data-request-summary]",
        "Заявка будет направлена на tender@kubtel.ru. Для прямой связи используйте только контакты бюджетного сектора."
      );
      setContactLinks("8 861 200-10-32", "tender@kubtel.ru");
      return;
    }

    setText("[data-request-eyebrow]", "Юрлица");
    if (b2gExtra) {
      b2gExtra.hidden = true;
      b2gExtra.open = false;
    }
    setText("[data-request-title]", "Обращение для юридического лица");
    setText(
      "[data-request-intro]",
      "Юридические лица оплачивают услуги по безналичному расчёту. Здесь можно оставить заявку на подключение, запросить документы, оплату или акт сверки, заказать звонок и задать любой другой вопрос."
    );
    setText("[data-request-contact-label]", "Контакты для юридических лиц");
    setText(
      "[data-request-summary]",
      "Заявка будет направлена на kubtel@kubtel.ru. Для прямой связи используйте контакты отдела по работе с юридическими лицами."
    );
    setContactLinks("8 861 200-10-60", "kubtel@kubtel.ru");
  }

  function updateAddressRequirement(
    serviceSelect: HTMLSelectElement | null,
    addressInput: HTMLInputElement | null
  ) {
    if (!serviceSelect || !addressInput) {
      return;
    }

    const optionalAddressTopics = new Set(["documents-payment", "callback", "other"]);
    const isRequired =
      Boolean(serviceSelect.value) && !optionalAddressTopics.has(serviceSelect.value);
    addressInput.required = isRequired;
    addressInput.setAttribute("aria-required", String(isRequired));
    setText(
      "[data-request-address-hint]",
      isRequired
        ? "Укажите город или адрес, чтобы проверить возможность подключения."
        : "Для документов, обратного звонка и других вопросов можно не указывать."
    );
  }

  function setContactLinks(phone: string, email: string) {
    document.querySelectorAll<HTMLAnchorElement>("[data-request-phone]").forEach((link) => {
      const digits = phone.replace(/\D/g, "");
      const normalizedDigits =
        digits.length === 11 && digits.startsWith("8") ? `7${digits.slice(1)}` : digits;
      link.textContent = phone;
      link.href = `tel:+${normalizedDigits}`;
    });
    document.querySelectorAll<HTMLAnchorElement>("[data-request-email]").forEach((link) => {
      link.textContent = email;
      link.href = `mailto:${email}`;
    });
  }

  function setText(selector: string, text: string) {
    const element = document.querySelector<HTMLElement>(selector);

    if (element) {
      element.textContent = text;
    }
  }

  function showBusinessPreviewNotice(form: HTMLFormElement) {
    const existingStatus = form.querySelector<HTMLElement>("#business-form-status");
    const status = existingStatus ?? document.createElement("div");
    const service = form.querySelector<HTMLSelectElement>('select[name="service"]');
    const serviceTitle = service?.selectedOptions[0]?.textContent?.trim() || "выбранная услуга";

    status.className = "form-status is-error";
    status.id = "business-form-status";
    status.setAttribute("role", "alert");
    status.setAttribute("tabindex", "-1");
    status.replaceChildren(
      createBusinessStatusLine("strong", "Заявка не отправлена с этого адреса."),
      createBusinessStatusLine("span", serviceTitle),
      createBusinessStatusLine(
        "span",
        isB2GRequest
          ? "Напишите на tender@kubtel.ru или позвоните 8 861 200-10-32."
          : "Напишите на kubtel@kubtel.ru или позвоните 8 861 200-10-60."
      )
    );

    if (!existingStatus) {
      form.prepend(status);
    }

    status.focus({ preventScroll: true });
  }

  function createBusinessStatusLine(tagName: "strong" | "span", text: string) {
    const element = document.createElement(tagName);
    element.textContent = text;

    return element;
  }
</script>
