---
import { getSitePath, SITE } from "@config/site";

const basePath = SITE.basePath === "/" ? "" : SITE.basePath.replace(/\/$/, "");
const currentPath =
  basePath && Astro.url.pathname.startsWith(`${basePath}/`)
    ? Astro.url.pathname.slice(basePath.length)
    : Astro.url.pathname;
const isBusinessPath = currentPath.startsWith("/business/");
const quietSections = [
  "/payment/",
  "/documents/",
  "/contacts/",
  "/about/",
  "/news/",
  "/search/",
  "/devices/",
  "/careers/",
  "/design-system/"
];
const shouldRender = !quietSections.some((path) => currentPath.startsWith(path));
const label = isBusinessPath ? "Оставить заявку" : "Проверить подключение";
const hint = isBusinessPath ? "Заявка для бизнеса" : "Адрес и условия уточним по заявке";
const href = isBusinessPath ? "/business/request/?segment=legal" : "/connect/#callback-request";
const actionLabel = isBusinessPath ? "Оставить заявку" : "Проверить";
---

{
  shouldRender && (
    <aside class="sticky-cta" aria-label={label}>
      <div>
        <strong>{label}</strong>
        <span>{hint}</span>
      </div>
      <a href={getSitePath(href)} aria-label={label}>
        {actionLabel}
      </a>
    </aside>
  )
}
