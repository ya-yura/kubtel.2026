---
import { getSitePath, SITE } from "@config/site";

const footerGroups = [
  {
    title: "Частным лицам",
    href: "/individual/",
    links: [
      { href: "/payment/", label: "Оплата" },
      { href: "/devices/", label: "Устройства" }
    ]
  },
  {
    title: "Бизнесу",
    href: "/business/",
    links: [
      { href: "/business/request/", label: "Заявка для бизнеса" },
      { href: "/individual/configurator/", label: "Конфигуратор услуг" }
    ]
  },
  {
    title: "Компания",
    links: [
      { href: "/news/", label: "Новости" },
      { href: "/careers/", label: "Вакансии" },
      { href: "/contacts/", label: "Контакты" }
    ]
  },
  {
    title: "Помощь",
    links: [
      { href: "/search/", label: "Поиск" },
      { href: "/documents/", label: "Документы" }
    ]
  }
];
---

<footer class="site-footer">
  <div>
    <a class="footer-brand" href={getSitePath("/")} aria-label={`${SITE.name}, на главную`}>
      <img
        class="footer-brand-logo"
        src={getSitePath("/logo-wordmark.svg")}
        alt=""
        width="114"
        height="58"
      />
    </a>
  </div>
  <nav aria-label="Нижняя навигация">
    <div class="site-footer__groups">
      {
        footerGroups.map((group) => (
          <section class="site-footer__group">
            <h2>
              {group.href ? <a href={getSitePath(group.href)}>{group.title}</a> : group.title}
            </h2>
            <ul>
              {group.links.map((item) => (
                <li>
                  <a href={getSitePath(item.href)}>{item.label}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </nav>
</footer>
