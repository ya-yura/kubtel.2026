---
import { footerNavItems } from "@config/routes";
import { getSitePath, SITE } from "@config/site";
---

<footer class="site-footer">
  <div>
    <a class="footer-brand" href={getSitePath("/")} aria-label={`${SITE.name}, на главную`}>
      <span class="brand-mark" aria-hidden="true">
        <img src={getSitePath("/logo-flat.svg")} alt="" width="34" height="34" />
      </span>
      <strong>{SITE.name}</strong>
    </a>
    <p>{SITE.shortDescription}</p>
  </div>
  <nav aria-label="Нижняя навигация">
    {footerNavItems.map((item) => <a href={getSitePath(item.href)}>{item.label}</a>)}
  </nav>
</footer>
