---
import { SITE } from "@config/site";

const counterId = import.meta.env.PUBLIC_YANDEX_METRIKA_ID ?? "32522125";
const isProductionSite =
  import.meta.env.PROD && /^https:\/\/(?:www\.)?kubtel\.ru$/.test(SITE.origin);
const counterScript = `(function (m, e, t, r, i, k, a) {
  m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
  m[i].l = 1 * new Date();
  k = e.createElement(t);
  a = e.getElementsByTagName(t)[0];
  k.async = 1;
  k.src = r;
  a.parentNode.insertBefore(k, a);
})(window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

ym(Number(${JSON.stringify(counterId)}), "init", {
  clickmap: true,
  trackLinks: true,
  accurateTrackBounce: true,
  webvisor: true
});`;
---

{
  isProductionSite && (
    <>
      <script is:inline set:html={counterScript} />
      <noscript>
        <div>
          <img
            src={`https://mc.yandex.ru/watch/${counterId}`}
            style="position:absolute; left:-9999px;"
            alt=""
          />
        </div>
      </noscript>
    </>
  )
}
