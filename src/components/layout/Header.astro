---
import { mainNavItems } from "@config/routes";
import { getPhoneHref, getSitePath, SITE } from "@config/site";

const currentPath = Astro.url.pathname;
const basePathPrefix = SITE.basePath === "/" ? "" : SITE.basePath.replace(/\/$/, "");
const normalizedCurrentPath =
  basePathPrefix && currentPath.startsWith(`${basePathPrefix}/`)
    ? currentPath.slice(basePathPrefix.length)
    : currentPath;
const selectedSegment = Astro.url.searchParams.get("segment");
const selectedService = Astro.url.searchParams.get("service");
const isBusinessPath = normalizedCurrentPath.startsWith("/business/");
const isBudgetBusinessPath =
  normalizedCurrentPath.startsWith("/business/b2g/") ||
  (normalizedCurrentPath.startsWith("/business/request/") &&
    (selectedSegment === "b2g" ||
      selectedSegment === "government" ||
      selectedService === "b2g-consultation"));
const headerPhone = isBudgetBusinessPath
  ? SITE.budgetPhone
  : isBusinessPath
    ? SITE.businessPhone
    : SITE.salesPhone;
const phoneContext = JSON.stringify({
  basePath: SITE.basePath,
  salesPhone: SITE.salesPhone,
  businessPhone: SITE.businessPhone,
  budgetPhone: SITE.budgetPhone
}).replace(/</g, "\\u003c");

function isCurrentPath(href: string) {
  return href === "/" ? normalizedCurrentPath === href : normalizedCurrentPath.startsWith(href);
}
---

<header class="site-header">
  <a class="brand" href={getSitePath("/")} aria-label={`${SITE.name}, на главную`}>
    <img
      class="brand-logo"
      src={getSitePath("/logo-wordmark.svg")}
      alt=""
      width="114"
      height="58"
    />
  </a>
  <nav class="site-nav" aria-label="Основная навигация">
    {
      mainNavItems.map((item) => (
        <a
          href={item.external ? item.href : getSitePath(item.href)}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener noreferrer" : undefined}
          aria-current={!item.external && isCurrentPath(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="site-header-tools">
    <details class="header-location">
      <summary>
        <span data-location-current>{SITE.serviceLocations[0]}</span>
        <span aria-hidden="true">⌄</span>
      </summary>
      <div class="header-location-popover">
        <strong>Зона подключения</strong>
        <ul>
          {
            SITE.serviceLocations.map((location) => (
              <li>
                <button
                  class="header-location-option"
                  type="button"
                  data-location-option={location}
                  aria-pressed={location === SITE.serviceLocations[0] ? "true" : "false"}
                >
                  {location}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </details>
    <a class="header-phone" href={getPhoneHref(headerPhone)} data-header-phone>
      {headerPhone}
    </a>
    <details class="mobile-nav">
      <summary aria-label="Открыть основное меню">
        <span class="nav-toggle-lines" aria-hidden="true"></span>
        <span class="visually-hidden">Открыть основное меню</span>
      </summary>
      <nav aria-label="Мобильная навигация" id="mobile-nav-panel">
        {
          mainNavItems.map((item) => (
            <a
              href={item.external ? item.href : getSitePath(item.href)}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
              aria-current={!item.external && isCurrentPath(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <details class="mobile-nav-location">
          <summary>
            Зона подключения: <span data-location-current>{SITE.serviceLocations[0]}</span>
          </summary>
          <ul>
            {
              SITE.serviceLocations.map((location) => (
                <li>
                  <button
                    class="header-location-option"
                    type="button"
                    data-location-option={location}
                    aria-pressed={location === SITE.serviceLocations[0] ? "true" : "false"}
                  >
                    {location}
                  </button>
                </li>
              ))
            }
          </ul>
        </details>
        <a
          class="mobile-nav-account"
          href={SITE.accountUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Личный кабинет
        </a>
        <a class="mobile-nav-phone" href={getPhoneHref(headerPhone)} data-header-phone>
          {headerPhone}
        </a>
        <button
          class="mobile-readability-toggle"
          type="button"
          data-readability-toggle
          aria-pressed="false"
        >
          Версия для слабовидящих
        </button>
      </nav>
    </details>
    <button
      class="header-readability-toggle"
      type="button"
      data-readability-toggle
      aria-pressed="false"
    >
      A+
    </button>
    <a class="header-account" href={SITE.accountUrl} target="_blank" rel="noopener noreferrer">
      Личный кабинет
    </a>
  </div>
  <script is:inline type="application/json" data-header-phone-config set:html={phoneContext} />
  <script>
    (() => {
      const configNode = document.querySelector("[data-header-phone-config]");
      const phoneLinks = document.querySelectorAll<HTMLAnchorElement>("[data-header-phone]");

      if (!configNode || phoneLinks.length === 0) {
        return;
      }

      const config = JSON.parse(configNode.textContent ?? "{}");
      const normalizedPath = normalizePath(window.location.pathname, config.basePath);
      const params = new URLSearchParams(window.location.search);
      const isBusinessPath = normalizedPath.startsWith("/business/");
      const isBudgetBusinessPath =
        normalizedPath.startsWith("/business/b2g/") ||
        (normalizedPath.startsWith("/business/request/") &&
          (params.get("segment") === "b2g" ||
            params.get("segment") === "government" ||
            params.get("service") === "b2g-consultation"));
      const phone = isBudgetBusinessPath
        ? config.budgetPhone
        : isBusinessPath
          ? config.businessPhone
          : config.salesPhone;

      phoneLinks.forEach((link) => {
        link.textContent = phone;
        link.href = getPhoneHref(phone);
      });

      function normalizePath(pathname: string, basePath: string) {
        const prefix = basePath && basePath !== "/" ? basePath.replace(/\/$/, "") : "";

        return prefix && pathname.startsWith(`${prefix}/`)
          ? pathname.slice(prefix.length)
          : pathname;
      }

      function getPhoneHref(phone: string) {
        const digits = String(phone).replace(/\D/g, "");
        const normalizedDigits =
          digits.length === 11 && digits.startsWith("8") ? `7${digits.slice(1)}` : digits;

        return `tel:+${normalizedDigits}`;
      }
    })();
  </script>
  <script>
    (() => {
      const storageKey = "kubtel-selected-location";
      const locationOptions = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-location-option]")
      );
      const currentLocationLabels = Array.from(
        document.querySelectorAll<HTMLElement>("[data-location-current]")
      );
      const defaultLocation = currentLocationLabels[0]?.textContent?.trim() ?? "";

      if (locationOptions.length === 0) {
        return;
      }

      const availableLocations = new Set(
        locationOptions
          .map((option) => option.dataset.locationOption)
          .filter((location): location is string => Boolean(location))
      );

      function getStoredLocation() {
        try {
          const storedLocation = window.localStorage.getItem(storageKey);
          return storedLocation && availableLocations.has(storedLocation)
            ? storedLocation
            : defaultLocation;
        } catch {
          return defaultLocation;
        }
      }

      function setLocation(location: string, persist = true) {
        if (!availableLocations.has(location)) {
          return;
        }

        if (persist) {
          try {
            window.localStorage.setItem(storageKey, location);
          } catch {
            // Storage can be unavailable in private browsing; the current page still updates.
          }
        }

        currentLocationLabels.forEach((label) => {
          label.textContent = location;
        });

        locationOptions.forEach((option) => {
          const isSelected = option.dataset.locationOption === location;

          option.classList.toggle("is-selected", isSelected);
          option.setAttribute("aria-pressed", String(isSelected));
        });

        document.dispatchEvent(
          new CustomEvent("kubtel:location-change", { detail: { location } })
        );
      }

      locationOptions.forEach((option) => {
        option.addEventListener("click", () => {
          const location = option.dataset.locationOption;

          if (!location) {
            return;
          }

          setLocation(location);
          document.querySelectorAll<HTMLDetailsElement>(".header-location, .mobile-nav-location")
            .forEach((details) => details.removeAttribute("open"));
        });
      });

      setLocation(getStoredLocation(), false);
    })();
  </script>
</header>
