---
type Props = {
  eyebrow: string;
  title: string;
  description?: string;
  class?: string;
  id?: string;
};

const { eyebrow, title, description, class: className, id } = Astro.props;
---

<section class:list={["page-intro", "section-pad", className]} id={id}>
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  {description && <p>{description}</p>}
  <slot />
</section>
