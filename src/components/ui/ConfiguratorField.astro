---
import type { ConfiguratorField, ConfiguratorFieldValue } from "@models/configurator";
import { getSitePath } from "@config/site";

type Props = {
  field: ConfiguratorField;
  serviceId: string;
  value?: ConfiguratorFieldValue;
  visible?: boolean;
};

const { field, serviceId, value, visible = true } = Astro.props;
const fieldName = `${serviceId}-${field.id}`;
const resolvedValue = value ?? field.defaultValue;
const defaultChoice = field.choices?.find((choice) => {
  if (typeof resolvedValue === "string") return resolvedValue === choice.id;
  if (Array.isArray(resolvedValue)) return resolvedValue.includes(choice.id);
  return choice.default;
});
const defaultValue =
  typeof resolvedValue === "string" || typeof resolvedValue === "number"
    ? resolvedValue
    : field.type === "counter"
      ? (field.min ?? 0)
      : "";
const choiceInputType =
  field.type === "radio" || (field.type === "checkbox" && !field.multiple) ? "radio" : "checkbox";
const showWhen = field.showWhen ? JSON.stringify(field.showWhen) : undefined;
const helpLinkHref = field.helpLink ? getSitePath(field.helpLink.href) : undefined;
---

{
  field.type === "select" ? (
    <label class="config-field" data-config-show-when={showWhen} hidden={!visible}>
      <span>{field.label}</span>
      <div class="config-select-control">
        <select data-config-field data-field-id={field.id} data-field-type={field.type}>
          {field.choices?.map((choice) => (
            <option
              value={choice.id}
              selected={choice.id === (defaultChoice?.id ?? field.choices?.[0]?.id)}
              data-label={choice.label}
              data-monthly={choice.monthlyPrice}
              data-once={choice.oneTimePrice}
            >
              {choice.label}
            </option>
          ))}
        </select>
      </div>
      {field.help && <small>{field.help}</small>}
      {field.helpLink && (
        <a class="config-field-link" href={helpLinkHref}>
          {field.helpLink.label} →
        </a>
      )}
    </label>
  ) : field.type === "counter" ? (
    <label
      class="config-field config-counter-field"
      data-config-show-when={showWhen}
      hidden={!visible}
    >
      <span>{field.label}</span>
      <div class="config-counter-control">
        <button type="button" data-config-step="-1" aria-label={`Уменьшить: ${field.label}`}>
          −
        </button>
        <input
          type="number"
          inputmode="numeric"
          value={defaultValue}
          min={field.min}
          max={field.max}
          step={field.step ?? 1}
          data-config-field
          data-field-id={field.id}
          data-field-type={field.type}
          data-monthly={field.monthlyPrice ?? 0}
          data-once={field.oneTimePrice ?? 0}
        />
        <button type="button" data-config-step="1" aria-label={`Увеличить: ${field.label}`}>
          +
        </button>
        {field.unit && <em>{field.unit}</em>}
      </div>
      {field.help && <small>{field.help}</small>}
      {field.helpLink && (
        <a class="config-field-link" href={helpLinkHref}>
          {field.helpLink.label} →
        </a>
      )}
    </label>
  ) : field.type === "checkbox" && !field.choices?.length ? (
    <label
      class="config-choice config-choice-single"
      data-config-show-when={showWhen}
      hidden={!visible}
    >
      <input
        type="checkbox"
        checked={resolvedValue === true}
        data-config-field
        data-field-id={field.id}
        data-field-type={field.type}
        data-monthly={field.monthlyPrice ?? 0}
        data-once={field.oneTimePrice ?? 0}
      />
      <span>
        <strong>{field.label}</strong>
        {field.help && <small>{field.help}</small>}
        {field.helpLink && (
          <a class="config-field-link" href={helpLinkHref}>
            {field.helpLink.label} →
          </a>
        )}
      </span>
    </label>
  ) : (
    <fieldset class="config-fieldset" data-config-show-when={showWhen} hidden={!visible}>
      <legend>{field.label}</legend>
      <div class="config-choice-grid">
        {field.choices?.map((choice) => (
          <label class="config-choice">
            <input
              type={choiceInputType}
              name={fieldName}
              value={choice.id}
              checked={
                Array.isArray(resolvedValue)
                  ? resolvedValue.includes(choice.id)
                  : typeof resolvedValue === "string"
                    ? resolvedValue === choice.id
                    : Boolean(choice.default)
              }
              data-config-field
              data-field-id={field.id}
              data-field-type={choiceInputType}
              data-field-multiple={field.multiple ? "true" : undefined}
              data-label={choice.label}
              data-monthly={choice.monthlyPrice}
              data-once={choice.oneTimePrice}
            />
            <span>
              <strong>{choice.label}</strong>
              {choice.description && <small>{choice.description}</small>}
            </span>
          </label>
        ))}
      </div>
      {field.help && <small class="config-field-help">{field.help}</small>}
      {field.helpLink && (
        <a class="config-field-link" href={helpLinkHref}>
          {field.helpLink.label} →
        </a>
      )}
    </fieldset>
  )
}
