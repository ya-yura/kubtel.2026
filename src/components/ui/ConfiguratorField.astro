---
import type {
  ConfiguratorField,
  ConfiguratorFieldValue,
  ConfiguratorTariffDetail
} from "@models/configurator";
import { getSitePath } from "@config/site";
import ConfiguratorChoiceField from "@components/ui/ConfiguratorChoiceField.astro";
import ConfiguratorCounterField from "@components/ui/ConfiguratorCounterField.astro";

type Props = {
  field: ConfiguratorField;
  serviceId: string;
  value?: ConfiguratorFieldValue;
  visible?: boolean;
  tariffDetails?: ConfiguratorTariffDetail[];
  choiceDependentFields?: Record<string, ConfiguratorField[]>;
  dependentValues?: Record<string, ConfiguratorFieldValue>;
};

const {
  field,
  serviceId,
  value,
  visible = true,
  tariffDetails = [],
  choiceDependentFields = {},
  dependentValues = {}
} = Astro.props;
const resolvedValue = value ?? field.defaultValue;
const defaultChoice = field.choices?.find((choice) => {
  if (typeof resolvedValue === "string") return resolvedValue === choice.id;
  if (Array.isArray(resolvedValue)) return resolvedValue.includes(choice.id);
  return choice.default;
});
const showWhen = field.showWhen ? JSON.stringify(field.showWhen) : undefined;
const helpLinkHref = field.helpLink ? getSitePath(field.helpLink.href) : undefined;
---

{
  field.type === "select" ? (
    <label class="config-field" data-config-show-when={showWhen} hidden={!visible}>
      <span>{field.label}</span>
      <div class="config-select-control">
        <select data-config-field data-field-id={field.id} data-field-type={field.type}>
          {field.choices?.map((choice) => (
            <option
              value={choice.id}
              selected={choice.id === (defaultChoice?.id ?? field.choices?.[0]?.id)}
              data-label={choice.label}
              data-monthly={choice.monthlyPrice}
              data-once={choice.oneTimePrice}
            >
              {choice.label}
            </option>
          ))}
        </select>
      </div>
      {tariffDetails.length > 0 && (
        <div class="config-tariff-details" data-config-tariff-details>
          {tariffDetails.map((detail) => (
            <div
              data-config-tariff-choice={detail.choiceId}
              hidden={detail.choiceId !== defaultChoice?.id}
            >
              <p>{detail.description}</p>
              <ul class="tag-list" aria-label="Подходит для">
                {detail.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
      {field.help && <small>{field.help}</small>}
      {field.helpLink && (
        <a class="config-field-link" href={helpLinkHref}>
          {field.helpLink.label} →
        </a>
      )}
    </label>
  ) : field.type === "counter" ? (
    <ConfiguratorCounterField field={field} value={value} visible={visible} />
  ) : field.type === "checkbox" && !field.choices?.length ? (
    <label
      class="config-choice config-choice-single"
      data-config-show-when={showWhen}
      hidden={!visible}
    >
      <input
        type="checkbox"
        checked={resolvedValue === true}
        data-config-field
        data-field-id={field.id}
        data-field-type={field.type}
        data-monthly={field.monthlyPrice ?? 0}
        data-once={field.oneTimePrice ?? 0}
      />
      <span>
        <strong>{field.label}</strong>
        {field.help && <small>{field.help}</small>}
        {field.helpLink && (
          <a class="config-field-link" href={helpLinkHref}>
            {field.helpLink.label} →
          </a>
        )}
      </span>
    </label>
  ) : (
    <ConfiguratorChoiceField
      field={field}
      serviceId={serviceId}
      value={value}
      visible={visible}
      choiceDependentFields={choiceDependentFields}
      dependentValues={dependentValues}
    />
  )
}
