---
import { formatRubles } from "@lib/format";
import { calculateMonthlyPrice } from "@lib/pricing";
import { getSitePath } from "@config/site";
import type { Tariff } from "@models/domain";
import ActionLink from "@components/ui/ActionLink.astro";

type Props = {
  tariff: Tariff;
};

const { tariff } = Astro.props;
const price = calculateMonthlyPrice(tariff);
const hasConfirmedPrice = tariff.commercialReview.priceStatus === "confirmed";
const hasConfirmedSpeed = tariff.commercialReview.speedStatus === "confirmed";
---

<article id={tariff.slug} class:list={["tariff-card", { "is-featured": tariff.isFeatured }]}>
  <div class="tariff-card-head">
    <div>
      <p class="eyebrow">{tariff.isFeatured ? "Рекомендуем" : "Тариф"}</p>
      <h3>{tariff.title}</h3>
    </div>
    <span class="speed">
      {hasConfirmedSpeed ? `${tariff.speedDownload}\u00a0Мбит/с` : "По адресу"}
    </span>
  </div>
  <p>{tariff.benefitDescription}</p>
  <ul class="tag-list" aria-label="Кому подходит">
    {tariff.bestFor.map((item) => <li>{item}</li>)}
  </ul>
  <div class="tariff-price">
    <strong>{hasConfirmedPrice ? formatRubles(price.total) : "Уточняется"}</strong>
    <span>{hasConfirmedPrice ? "в\u00a0месяц" : "для вашего адреса"}</span>
  </div>
  {
    tariff.proof.status === "confirmed" && (
      <p class="proof confirmed">
        <strong>{tariff.proof.label}:</strong>
        {tariff.proof.value}
      </p>
    )
  }
  <ActionLink href={getSitePath(`/individual/configurator/?service=internet#configurator`)}>
    Настроить подключение
  </ActionLink>
</article>
