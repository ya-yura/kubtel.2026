---
import { getPhoneHref, SITE } from "@config/site";
import SectionHeading from "@components/ui/SectionHeading.astro";

const chatLinks = [
  SITE.maxChatUrl ? { label: "MAX", href: SITE.maxChatUrl } : null,
  SITE.vkChatUrl ? { label: "VK", href: SITE.vkChatUrl } : null
].filter((item): item is { label: string; href: string } => Boolean(item));

const officeMapUrl = `https://yandex.ru/maps/?text=${encodeURIComponent(SITE.officeAddress)}`;
---

<section class="section-pad support-pathways" id="support-pathways">
  <SectionHeading
    eyebrow="Каналы связи"
    title="Выберите удобный способ обращения"
    description="Телефон, почта, официальные чаты и адрес офиса собраны в одном месте."
  />
  <div class="pathway-grid support-channel-grid">
    <article>
      <span>Единый круглосуточный номер</span>
      <h3>{SITE.supportDirectPhone}</h3>
      <p>Подключение, техническая поддержка, вопросы по оплате и услугам.</p>
      <a href={getPhoneHref(SITE.supportDirectPhone)}>Позвонить</a>
    </article>
    <article>
      <span>Почта</span>
      <h3>{SITE.supportEmail}</h3>
      <p>Для заявок, которые удобно описать письмом: адрес, договор, скриншот, история вопроса.</p>
      <a href={`mailto:${SITE.supportEmail}`}>Написать</a>
    </article>
    {
      chatLinks.length > 0 && (
        <article>
          <span>Мессенджеры</span>
          <h3>Официальные чаты</h3>
          <p>Выберите подтверждённый канал поддержки.</p>
          <div class="button-row">
            {chatLinks.map((chat) => (
              <a href={chat.href} target="_blank" rel="noopener noreferrer">
                {chat.label}
              </a>
            ))}
          </div>
        </article>
      )
    }
    <article>
      <span>Офис</span>
      <h3>{SITE.officeAddress}</h3>
      <a href={officeMapUrl} target="_blank" rel="noopener noreferrer">Открыть в Яндекс Картах</a>
    </article>
  </div>
</section>
