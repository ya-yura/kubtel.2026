---
import type { AppLink } from "@models/configurator";

type Props = {
  links: AppLink[];
  title?: string;
  variant?: "default" | "compact";
};

const { links, title = "Скачать приложение", variant = "default" } = Astro.props;
---

{
  variant === "compact" ? (
    <section class="app-links-inline" aria-label={title}>
      <div class="app-links-inline__copy">
        <p class="eyebrow">Приложение</p>
        <h3>{title}</h3>
        <p>Откройте камеры с телефона, планшета или телевизора.</p>
      </div>
      <div class="app-links-inline__links">
        {links.map((link) => (
          <a
            class="app-link-chip"
            href={link.href}
            target={link.external === false ? undefined : "_blank"}
            rel={link.external === false ? undefined : "noopener noreferrer"}
          >
            <span>{link.platform}</span>
            <strong>{link.label}</strong>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
  ) : (
    <section class="resource-panel app-links-panel" aria-label={title}>
      <div class="resource-panel-head">
        <p class="eyebrow">Приложения</p>
        <h2>{title}</h2>
      </div>
      <div class="resource-link-grid">
        {links.map((link) => (
          <a
            class="resource-link"
            href={link.href}
            target={link.external === false ? undefined : "_blank"}
            rel={link.external === false ? undefined : "noopener noreferrer"}
          >
            <span>{link.platform}</span>
            <strong>{link.label}</strong>
          </a>
        ))}
      </div>
    </section>
  )
}
