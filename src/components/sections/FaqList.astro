---
import type { FaqItem } from "@models/domain";
import SectionHeading from "@components/ui/SectionHeading.astro";
import StatusBadge from "@components/ui/StatusBadge.astro";

type Props = {
  items: FaqItem[];
};

const { items } = Astro.props;
---

<section class="section-pad faq-section" id="faq">
  <SectionHeading eyebrow="FAQ" title="Ответы, после которых спокойнее" />
  <div class="faq-list">
    {
      items.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
          {item.proof.status === "confirmed" && (
            <StatusBadge
              as="p"
              status="confirmed"
              label={`${item.proof.label}: ${item.proof.value}`}
            />
          )}
        </details>
      ))
    }
  </div>
</section>
