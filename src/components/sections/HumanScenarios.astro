---
import PromoImage from "@components/ui/PromoImage.astro";
import { getSitePath } from "@config/site";
import { promoVisuals } from "@lib/visuals";

const scenarios = [
  {
    number: "01",
    title: "После большой тройки",
    text: "Люди приходят после сложных меню и поддержки «для галочки». Здесь важны быстрый отклик, понятный статус обращения и уважительный разговор.",
    href: "/connect/#callback-request",
    action: "Проверить подключение"
  },
  {
    number: "02",
    title: "По рекомендации",
    text: "Типичный амбассадор - технически подкованный сосед, коллега или друг. Он советует тех, кто отвечает за слова.",
    href: "/about/",
    action: "Узнать о компании"
  },
  {
    number: "03",
    title: "Когда нужна помощь",
    text: "Ценность Kubtel особенно видна при обращении в сервис: просьба или проблема не тонет в бюрократии, а попадает к живой команде.",
    href: "/support/",
    action: "Перейти в поддержку"
  },
  {
    number: "04",
    title: "Когда возвращаются",
    text: "Часть клиентов уходит к громкому бренду или акции, разочаровывается и возвращается туда, где обещанное правда происходит.",
    href: "/tariffs/",
    action: "Сравнить тарифы"
  }
];
---

<section class="section-pad scenarios-section">
  <div class="section-heading">
    <p class="eyebrow">Почему приходят</p>
    <h2>Kubtel выбирают не&nbsp;из-за громкой акции, а&nbsp;из-за внимательного сервиса</h2>
  </div>
  <PromoImage visual={promoVisuals.localTeam} class="is-banner scenarios-visual" />
  <div class="bento-grid">
    {
      scenarios.map((scenario) => (
        <a class="scenario-card" href={getSitePath(scenario.href)}>
          <span>{scenario.number}</span>
          <h3>{scenario.title}</h3>
          <p>{scenario.text}</p>
          <strong>{scenario.action}</strong>
        </a>
      ))
    }
  </div>
</section>
