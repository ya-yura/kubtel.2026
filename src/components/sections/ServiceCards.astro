---
import PromoImage from "@components/ui/PromoImage.astro";
import { getSitePath } from "@config/site";
import { getResidentialServiceVisual } from "@lib/visuals";
import type { Service, Tariff } from "@models/domain";
import SectionHeading from "@components/ui/SectionHeading.astro";
import StatusBadge from "@components/ui/StatusBadge.astro";

type Props = {
  services: Service[];
  tariffs?: Tariff[];
  title?: string;
  lead?: string;
};

const {
  services,
  tariffs = [],
  title = "Домашние сценарии без технического тумана",
  lead = "Видео, игры, учёба, ТВ, статический IP или роутер\u00a0— всё это можно выбрать без обязательной анкеты до звонка."
} = Astro.props;

const categoryLabels: Record<string, string> = {
  connectivity: "Связь",
  media: "Медиа",
  options: "Опции"
};

const tariffTitleBySlug = new Map(tariffs.map((tariff) => [tariff.slug, tariff.title]));
---

<section class="section-pad services-section" id="services">
  <SectionHeading eyebrow="Услуги" title={title} description={lead} />
  <div class="service-grid">
    {
      services.map((service) => {
        const primaryFact = service.facts.find((fact) => fact.status === "confirmed");
        const visual = getResidentialServiceVisual(service.slug);
        const relatedTariffs = service.relatedTariffs
          .map((slug) => tariffTitleBySlug.get(slug) ?? slug)
          .slice(0, 3);

        return (
          <article class="service-card">
            <div class="service-card-head">
              <span class="service-category">
                {categoryLabels[service.category] ?? service.category}
              </span>
              {service.contentSource.status === "confirmed" && (
                <StatusBadge status="confirmed" label="Официальная услуга" />
              )}
            </div>
            <PromoImage visual={visual} class="is-card service-card-media" showMeta={false} />
            <h3>{service.title}</h3>
            <p>{service.shortDescription}</p>
            <ul class="service-benefits" aria-label={`Польза услуги ${service.title}`}>
              {service.benefits.map((benefit) => (
                <li>{benefit}</li>
              ))}
            </ul>
            {primaryFact && (
              <p class:list={["proof", primaryFact.status]}>
                <strong>{primaryFact.label}:</strong>
                {primaryFact.value}
              </p>
            )}
            {relatedTariffs.length > 0 && (
              <div class="related-tariffs">
                <span>Связанные тарифы</span>
                <ul>
                  {relatedTariffs.map((title) => (
                    <li>{title}</li>
                  ))}
                </ul>
              </div>
            )}
            <a
              class="card-action"
              href={getSitePath(`/individual/configurator/?service=${service.slug}#configurator`)}
            >
              Уточнить условия
            </a>
          </article>
        );
      })
    }
  </div>
</section>
