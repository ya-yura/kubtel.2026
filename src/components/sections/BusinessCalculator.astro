---
import { getSitePath } from "@config/site";
import {
  businessCalculatorPricing,
  type BusinessCalculatorConfig
} from "@lib/business/calculator-ui";
import { telephonyPricing } from "@lib/business/telephony-pricing";

type Props = {
  config: BusinessCalculatorConfig;
  requestPath?: string;
};

const { config, requestPath: requestPathProp } = Astro.props;
const calculatorId = `business-calculator-${config.id ?? config.type}`;
const isSimpleChoiceFlow = config.telephonyVariant === "basic";
const sourceNotes = config.sourceNote
  ? Array.isArray(config.sourceNote)
    ? config.sourceNote
    : [config.sourceNote]
  : [];
const requestPath = getSitePath(requestPathProp ?? "/business/request/");
const payload = JSON.stringify({
  config,
  pricing: businessCalculatorPricing,
  telephonyPricing,
  requestPath
}).replace(/</g, "\\u003c");
const formatTelephonyPrice = (value: number) =>
  `${new Intl.NumberFormat("ru-RU", { maximumFractionDigits: 0 }).format(value)} ₽`;
const formatTrafficPrice = (value: number) =>
  `${new Intl.NumberFormat("ru-RU", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  }).format(value)} ₽/мин.`;
const getSimpleChoiceDescription = (fieldName: string, optionValue: string) => {
  if (fieldName === "connectionType") {
    const price =
      telephonyPricing.ordinary.connectionOneTime[
        optionValue as keyof typeof telephonyPricing.ordinary.connectionOneTime
      ];
    return `${formatTelephonyPrice(price)} разово`;
  }

  if (optionValue === "timed") {
    return `${formatTelephonyPrice(telephonyPricing.ordinary.monthly.timed)}/мес. + ${formatTrafficPrice(telephonyPricing.ordinary.trafficPerMinute)}`;
  }

  return `${formatTelephonyPrice(telephonyPricing.ordinary.monthly.unlimited)}/мес., местные звонки включены`;
};
const virtualPbxDigitalSetup = telephonyPricing.virtualPbx.setup.digital;
const virtualPbxAnalogSetup = telephonyPricing.virtualPbx.setup.analog;
const virtualPbxDigitalBase = virtualPbxDigitalSetup.base;
const virtualPbxAnalogBase = virtualPbxAnalogSetup.base;
const virtualPbxDigitalAdditional = virtualPbxDigitalSetup.additional;
const formatAdditionalDigitalPorts = (quantity: number) => {
  const amount = quantity === 1 ? "один" : quantity === 4 ? "четыре" : String(quantity);
  const lastTwoDigits = quantity % 100;
  const lastDigit = quantity % 10;
  const noun =
    lastTwoDigits >= 11 && lastTwoDigits <= 14
      ? "портов"
      : lastDigit === 1
        ? "порт"
        : lastDigit >= 2 && lastDigit <= 4
          ? "порта"
          : "портов";

  return `${amount} дополнительн${quantity === 1 ? "ый" : "ых"} цифров${quantity === 1 ? "ой" : "ых"} ${noun}`;
};
---

<section class="section-pad business-calculator-section" id={calculatorId}>
  <div class="section-heading">
    <p class="eyebrow">Калькулятор</p>
    <h2>{config.title}</h2>
    <p>{config.lead}</p>
  </div>

  <div class="business-calculator" data-business-calculator>
    <script is:inline type="application/json" data-calculator-config set:html={payload} />

    <form
      class:list={[
        "business-calculator-form",
        { "business-calculator-form--simple": isSimpleChoiceFlow }
      ]}
      data-calculator-form
    >
      {
        !isSimpleChoiceFlow && (
          <div class="calculator-form-intro">
            <span class="calculator-form-kicker">Параметры</span>
            <p>Выберите настройки услуги — итог обновится автоматически.</p>
          </div>
        )
      }
      {
        config.fields.map((field, fieldIndex) => {
          if (field.kind === "select") {
            if (isSimpleChoiceFlow) {
              return (
                <fieldset class="calculator-choice-group">
                  <legend>{field.label}</legend>
                  <div class="calculator-choice-options">
                    {field.options.map((option) => (
                      <label class="calculator-choice-option">
                        <input
                          class="visually-hidden"
                          type="radio"
                          name={field.name}
                          value={option.value}
                          checked={option.value === field.value}
                          data-calculator-field
                        />
                        <span class="calculator-choice-card">
                          <strong>{option.label}</strong>
                          <small>{getSimpleChoiceDescription(field.name, option.value)}</small>
                        </span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              );
            }

            return (
              <label class="calculator-field form-field" data-calculator-field-card>
                <span class="calculator-field-heading">
                  <span class="calculator-field-step" aria-hidden="true">
                    {fieldIndex + 1}
                  </span>
                  <span>{field.label}</span>
                </span>
                <select name={field.name} data-calculator-field>
                  {field.options.map((option) => (
                    <option value={option.value} selected={option.value === field.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
                {field.help && <small>{field.help}</small>}
              </label>
            );
          }

          if (field.kind === "checkbox") {
            return (
              <label class="calculator-field form-field calculator-toggle">
                <input
                  name={field.name}
                  type="checkbox"
                  checked={field.checked}
                  data-calculator-field
                />
                <span>{field.label}</span>
                {field.help && <small>{field.help}</small>}
              </label>
            );
          }

          return (
            <label class="calculator-field form-field" data-calculator-field-card>
              <span class="calculator-field-heading">
                <span class="calculator-field-step" aria-hidden="true">
                  {fieldIndex + 1}
                </span>
                <span>{field.label}</span>
              </span>
              <div class="calculator-number-control">
                <button
                  type="button"
                  class="calculator-step-button"
                  data-step-button="-1"
                  aria-label={`Уменьшить ${field.label}`}
                >
                  -
                </button>
                <input
                  name={field.name}
                  type="number"
                  min={field.min}
                  max={field.max}
                  step={field.step}
                  value={field.value}
                  inputmode="numeric"
                  data-calculator-field
                />
                <button
                  type="button"
                  class="calculator-step-button"
                  data-step-button="1"
                  aria-label={`Увеличить ${field.label}`}
                >
                  +
                </button>
              </div>
              {field.suffix && <small>{field.suffix}</small>}
              {field.help && <small>{field.help}</small>}
            </label>
          );
        })
      }
    </form>

    <aside class="business-calculator-result" aria-live="polite">
      <span class="service-category">Итого</span>
      <h3 data-calculator-summary>Конфигурация</h3>
      <div class="calculator-total-grid">
        <div>
          <span>В месяц</span>
          <strong data-calculator-monthly>По запросу</strong>
        </div>
        <div>
          <span>Разово</span>
          <strong data-calculator-onetime>По запросу</strong>
        </div>
      </div>
      <ul class="calculator-lines" data-calculator-lines hidden={isSimpleChoiceFlow}></ul>
      <p class="calculator-note" data-calculator-note>
        Финальная цена фиксируется после проверки площадки и&nbsp;коммерческих условий.
      </p>
      <a class="card-action" href={requestPath} data-calculator-cta>{config.submitLabel}</a>
      {
        sourceNotes.length > 0 &&
          (config.telephonyVariant ? (
            <details class="calculator-glossary calculator-conditions">
              <summary>Условия расчёта</summary>
              <ul class="calculator-note calculator-note-list">
                {sourceNotes.map((note) => (
                  <li>{note}</li>
                ))}
              </ul>
            </details>
          ) : (
            <ul class="calculator-note calculator-note-list">
              {sourceNotes.map((note) => (
                <li>{note}</li>
              ))}
            </ul>
          ))
      }
      {
        config.sourceUrl && (
          <p class="calculator-note">
            <a href={config.sourceUrl} target="_blank" rel="noopener noreferrer">
              {config.sourceLabel ?? "Официальный источник"}
            </a>
          </p>
        )
      }
      {
        config.glossary && (
          <details class="calculator-glossary">
            <summary>Расшифровка терминов</summary>
            <dl>
              {config.glossary.map((item) => (
                <>
                  <dt>{item.term}</dt>
                  <dd>{item.description}</dd>
                </>
              ))}
            </dl>
          </details>
        )
      }
      {
        config.telephonyVariant === "virtual-pbx" && (
          <details class="calculator-glossary">
            <summary>Расшифровка калькулятора</summary>
            <p>
              Предоставление внутреннего цифрового порта в рамках виртуальной АТС —{" "}
              {formatTelephonyPrice(telephonyPricing.virtualPbx.portMonthly.digital)}/мес.;
              аналогового внутреннего порта —{" "}
              {formatTelephonyPrice(telephonyPricing.virtualPbx.portMonthly.analog)}/мес.
            </p>
            <p>Организация виртуальной АТС, одного номера ТФОП, одной внешней линии и:</p>
            <ul>
              {virtualPbxDigitalBase.map((option) => (
                <li>
                  до {option.ports} цифровых портов — {formatTelephonyPrice(option.price)}
                </li>
              ))}
              {virtualPbxAnalogBase.map((option) => (
                <li>
                  до {option.ports} аналоговых портов — {formatTelephonyPrice(option.price)}
                </li>
              ))}
            </ul>
            <p>Выделение дополнительных цифровых портов в рамках существующей виртуальной АТС:</p>
            <ul>
              {virtualPbxDigitalAdditional.map((option) => (
                <li>
                  {formatAdditionalDigitalPorts(option.ports)} —{" "}
                  {formatTelephonyPrice(option.price)}
                </li>
              ))}
            </ul>
            <p>
              Выделение дополнительного номера ТФОП без возможности выбора номера в рамках
              виртуальной АТС —{" "}
              {formatTelephonyPrice(telephonyPricing.virtualPbx.extraNumberOneTime)}.
            </p>
            <p>
              Выделение дополнительной внешней линии в рамках виртуальной АТС —{" "}
              {formatTelephonyPrice(telephonyPricing.virtualPbx.extraExternalLineOneTime)}.
            </p>
            <p>
              Услуга «Выбор номера» рассчитывается индивидуально в зависимости от категории
              выбранного номера.
            </p>
          </details>
        )
      }
    </aside>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-business-calculator]").forEach((calculator) => {
    const configNode = calculator.querySelector<HTMLScriptElement>("[data-calculator-config]");
    const form = calculator.querySelector<HTMLFormElement>("[data-calculator-form]");
    const monthlyNode = calculator.querySelector<HTMLElement>("[data-calculator-monthly]");
    const oneTimeNode = calculator.querySelector<HTMLElement>("[data-calculator-onetime]");
    const summaryNode = calculator.querySelector<HTMLElement>("[data-calculator-summary]");
    const linesNode = calculator.querySelector<HTMLElement>("[data-calculator-lines]");
    const noteNode = calculator.querySelector<HTMLElement>("[data-calculator-note]");
    const cta = calculator.querySelector<HTMLAnchorElement>("[data-calculator-cta]");

    if (
      !configNode ||
      !form ||
      !monthlyNode ||
      !oneTimeNode ||
      !summaryNode ||
      !linesNode ||
      !cta
    ) {
      return;
    }

    const calculatorForm = form;
    const monthlyValue = monthlyNode;
    const oneTimeValue = oneTimeNode;
    const summaryValue = summaryNode;
    const lineItems = linesNode;
    const submitLink = cta;
    const payload = JSON.parse(configNode.textContent ?? "{}");
    const config = payload.config;
    const pricing = payload.pricing ?? {};
    const requestPath = payload.requestPath ?? "/business/request/";

    form.addEventListener("input", () => syncCalculator());
    form.addEventListener("change", () => syncCalculator());
    form.querySelectorAll<HTMLButtonElement>("[data-step-button]").forEach((button) => {
      button.addEventListener("click", () => {
        const input = button
          .closest(".calculator-number-control")
          ?.querySelector<HTMLInputElement>('input[type="number"]');

        if (!input) {
          return;
        }

        const direction = Number(button.dataset.stepButton || 0);
        const step = Number(input.step || 1);
        const min = Number(input.min || 0);
        const max = Number(input.max || Number.MAX_SAFE_INTEGER);
        const nextValue = Math.min(max, Math.max(min, Number(input.value || 0) + direction * step));

        input.value = String(nextValue);
        input.dispatchEvent(new Event("input", { bubbles: true }));
      });
    });
    syncCalculator();

    function syncCalculator() {
      const values = readValues(calculatorForm);
      const result = calculate(config, pricing, values, payload.telephonyPricing);
      const summary = buildSummary(config, values);
      const hasQuoteItems = result.unknownItems.length > 0;
      const showKnownTotals = Boolean(config.showKnownTotalsWithQuoteItems);
      const isIndividual = result.forceIndividual || (hasQuoteItems && !showKnownTotals);
      const canPublishEstimate = !result.forceIndividual && (!hasQuoteItems || showKnownTotals);

      summaryValue.textContent = summary;
      monthlyValue.textContent = isIndividual
        ? "Индивидуальный расчёт"
        : result.hasMonthly
          ? `${formatRubles(result.monthly)}/мес.`
          : "По запросу";
      oneTimeValue.textContent = isIndividual
        ? "Индивидуальный расчёт"
        : result.hasOneTime
          ? formatRubles(result.oneTime)
          : "По запросу";
      lineItems.replaceChildren(
        ...result.lines.map((line) => {
          const item = document.createElement("li");
          const labelGroup = document.createElement("span");
          const label = document.createElement("span");
          const value = document.createElement("strong");
          label.textContent = line.label;
          labelGroup.append(label);
          if (line.unit) {
            const unit = document.createElement("small");
            unit.textContent = line.unit;
            labelGroup.append(unit);
          }
          value.textContent = line.value;
          item.append(labelGroup, value);
          return item;
        })
      );

      if (noteNode) {
        noteNode.hidden = !result.forceIndividual && !hasQuoteItems;
        noteNode.textContent = result.forceIndividual
          ? `Персональный расчёт: ${result.unknownItems.join(", ")}.`
          : hasQuoteItems
            ? `${showKnownTotals ? "По запросу" : "Индивидуальный расчёт"}: ${result.unknownItems.join(", ")}.`
            : "";
      }

      const requestUrl = new URL(requestPath, document.baseURI);
      const params = requestUrl.searchParams;
      params.set("service", config.serviceSlug);
      params.set("configurationSummary", buildConfigurationText(summary, result, showKnownTotals));

      if (canPublishEstimate && result.hasMonthly) {
        params.set("monthlyEstimate", String(result.monthly));
      }

      if (canPublishEstimate && result.hasOneTime) {
        params.set("oneTimeEstimate", String(result.oneTime));
      }

      submitLink.href = requestUrl.toString();
    }
  });

  function readValues(form: HTMLFormElement) {
    const values: Record<string, string | number | boolean> = {};

    form
      .querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-calculator-field]")
      .forEach((field) => {
        if (field instanceof HTMLInputElement && field.type === "radio") {
          if (field.checked) {
            values[field.name] = field.value;
          }
          return;
        }

        if (field instanceof HTMLInputElement && field.type === "checkbox") {
          values[field.name] = field.checked;
          return;
        }

        if (field instanceof HTMLInputElement && field.type === "number") {
          values[field.name] = Number(field.value || 0);
          return;
        }

        values[field.name] = field.value;
      });

    return values;
  }

  function calculate(
    config: any,
    pricing: Record<string, any>,
    values: Record<string, any>,
    telephonyPricing: any
  ) {
    const result = {
      monthly: 0,
      oneTime: 0,
      hasMonthly: false,
      hasOneTime: false,
      unknownItems: [] as string[],
      requiredConsultation: false,
      forceIndividual: false,
      lines: [] as Array<{ label: string; value: string; unit?: string }>
    };

    for (const line of config.lines) {
      if (line.kind === "telephony") {
        addTelephonyLine(result, line.label, config.telephonyVariant, values, telephonyPricing);
        continue;
      }

      if (line.kind === "fixed") {
        addLine(result, pricing[line.key], line.label, 1, 1);
      }

      if (line.kind === "repeated") {
        const rawQuantity = Number(values[line.quantityField] || 0);
        const individualLimit = getIndividualLimit(config, line.quantityField, rawQuantity);

        if (individualLimit !== null) {
          addPersonalCalculationLine(result, line.label, rawQuantity, individualLimit);
          continue;
        }

        const quantity = line.quantityStep
          ? Math.ceil(rawQuantity / line.quantityStep)
          : rawQuantity;
        addLine(result, pricing[line.key], line.label, quantity, rawQuantity);
      }

      if (line.kind === "optional" && values[line.enabledField]) {
        addLine(result, pricing[line.key], line.label, 1, 1);
      }

      if (line.kind === "select") {
        const value = String(values[line.selectField] ?? "");
        const valueLabel = line.valueLabels?.[value] ?? value;
        addLine(
          result,
          pricing[`${line.keyPrefix}${value}`],
          `${line.labelPrefix}: ${valueLabel}`,
          1,
          1
        );
      }

      if (line.kind === "repeatedSelect") {
        const value = String(values[line.selectField] ?? "");
        const valueLabel = line.valueLabels?.[value] ?? value;
        const quantity = Number(values[line.quantityField] || 0);
        const individualLimit = getIndividualLimit(config, line.quantityField, quantity);

        if (individualLimit !== null) {
          addPersonalCalculationLine(
            result,
            `${line.labelPrefix}: ${valueLabel}`,
            quantity,
            individualLimit
          );
          continue;
        }

        addLine(
          result,
          pricing[`${line.keyPrefix}${value}`],
          `${line.labelPrefix}: ${valueLabel}`,
          quantity,
          quantity
        );
      }
    }

    return result;
  }

  function addTelephonyLine(
    result: any,
    label: string,
    variant: string,
    values: Record<string, any>,
    pricing: any
  ) {
    const connectionType = values.connectionType === "analog" ? "analog" : "digital";
    const tariff = values.tariff === "timed" ? "timed" : "unlimited";

    if (variant === "basic") {
      const monthly = pricing.ordinary.monthly[tariff];
      const oneTime = pricing.ordinary.connectionOneTime[connectionType];
      pushCalculatedLine(
        result,
        label,
        monthly,
        oneTime,
        tariff === "timed" ? "местный трафик: 0,60 ₽/мин." : "местный трафик включён"
      );
      return;
    }

    if (variant === "multichannel") {
      const ports = Number(values.ports || 0);
      const monthly = ports * pricing.multichannel.portMonthly[connectionType][tariff];
      const oneTime = calculateTelephonySetupCost(
        pricing.multichannel.setup[connectionType],
        ports
      );
      pushCalculatedLine(
        result,
        `${label}: ${formatPortCount(ports)}`,
        monthly,
        oneTime,
        tariff === "timed" ? "местный трафик: 0,60 ₽/мин." : "местный трафик включён"
      );
      return;
    }

    if (variant === "pro") {
      const phoneNumbers = Number(values.phoneNumbers || 0);
      const externalLines = Number(values.externalLines || 0);
      const extraNumbers = Math.max(phoneNumbers - externalLines, 0);
      const monthly =
        externalLines * pricing.pro.lineMonthly[tariff] +
        extraNumbers * pricing.pro.extraNumberMonthly;
      const oneTime =
        pricing.pro.installation + Math.max(phoneNumbers, externalLines) * pricing.pro.portOneTime;
      pushCalculatedLine(
        result,
        `${label}: ${formatNumberCount(phoneNumbers, true)}, ${formatLineCount(externalLines, true)}`,
        monthly,
        oneTime,
        tariff === "timed" ? "местный трафик: 0,60 ₽/мин." : "местный трафик включён"
      );
      return;
    }

    const ports = Number(values.ports || 0);
    const phoneNumbers = Number(values.phoneNumbers || 0);
    const externalLines = Number(values.externalLines || 0);
    const extraNumbers = Math.max(phoneNumbers - externalLines, 0);
    const monthly =
      ports * pricing.virtualPbx.portMonthly[connectionType] +
      externalLines * pricing.virtualPbx.externalLineMonthly[connectionType][tariff] +
      (connectionType === "digital" ? extraNumbers * pricing.virtualPbx.extraNumberMonthly : 0);
    const oneTime =
      calculateTelephonySetupCost(pricing.virtualPbx.setup[connectionType], ports) +
      Math.max(phoneNumbers - 1, 0) * pricing.virtualPbx.extraNumberOneTime +
      Math.max(externalLines - 1, 0) * pricing.virtualPbx.extraExternalLineOneTime;
    pushCalculatedLine(
      result,
      `${label}: ${formatPortCount(ports, true)}, ${formatNumberCount(phoneNumbers)}, ${formatLineCount(externalLines)}`,
      monthly,
      oneTime,
      tariff === "timed" ? "местный трафик: 0,60 ₽/мин." : "местный трафик включён"
    );
  }

  function calculateTelephonySetupCost(setup: any, ports: number) {
    const additionalCosts = Array.from({ length: ports + 1 }, () => Number.POSITIVE_INFINITY);
    additionalCosts[0] = 0;

    for (let count = 1; count <= ports; count += 1) {
      for (const option of setup.additional) {
        if (count >= option.ports) {
          additionalCosts[count] = Math.min(
            additionalCosts[count],
            additionalCosts[count - option.ports] + option.price
          );
        }
      }
    }

    return Math.min(
      ...setup.base.map((base: any) =>
        ports <= base.ports ? base.price : base.price + additionalCosts[ports - base.ports]
      )
    );
  }

  function pushCalculatedLine(
    result: any,
    label: string,
    monthly: number,
    oneTime: number,
    unit?: string
  ) {
    result.monthly += monthly;
    result.oneTime += oneTime;
    result.hasMonthly = true;
    result.hasOneTime = true;
    result.lines.push({
      label,
      value: `${formatRubles(monthly)}/мес. + ${formatRubles(oneTime)}`,
      unit
    });
  }

  function getIndividualLimit(config: any, fieldName: string, quantity: number) {
    const field = config.fields.find(
      (item: any) => item.kind === "number" && item.name === fieldName
    );

    return typeof field?.individualAbove === "number" && quantity > field.individualAbove
      ? field.individualAbove
      : null;
  }

  function addPersonalCalculationLine(
    result: any,
    label: string,
    rawQuantity: number,
    limit: number
  ) {
    result.requiredConsultation = true;
    result.forceIndividual = true;
    pushUnknown(result, `${label}: более ${limit} шт.`);
    result.lines.push({
      label: `${label} × ${rawQuantity}`,
      value: "персональный расчёт"
    });
  }

  function addLine(result: any, price: any, label: string, quantity: number, rawQuantity: number) {
    if (quantity <= 0) {
      return;
    }

    if (!price || price.status !== "confirmed") {
      result.requiredConsultation = true;
      pushUnknown(result, label);
      result.lines.push({ label: `${label} × ${rawQuantity}`, value: "по запросу" });
      return;
    }

    const monthly = typeof price.monthly === "number" ? price.monthly * quantity : null;
    const oneTime = typeof price.oneTime === "number" ? price.oneTime * quantity : null;

    if (monthly !== null) {
      result.monthly += monthly;
      result.hasMonthly = true;
    }

    if (oneTime !== null) {
      result.oneTime += oneTime;
      result.hasOneTime = true;
    }

    result.lines.push({
      label: `${label} × ${rawQuantity}`,
      value: [
        monthly !== null ? `${formatRubles(monthly)}/мес.` : "",
        oneTime !== null ? formatRubles(oneTime) : ""
      ]
        .filter(Boolean)
        .join(" + "),
      unit: price.unitLabel
    });
  }

  function pushUnknown(result: { unknownItems: string[] }, value: string) {
    if (!result.unknownItems.includes(value)) {
      result.unknownItems.push(value);
    }
  }

  function buildSummary(config: any, values: Record<string, any>) {
    const type = config.type;

    if (type === "cctv") {
      const summaryParts = [
        `${values.camerasCount} камер`,
        `архив ${values.archiveDays}\u00a0дней`,
        Number(values.hardwareCount || 0) > 0 ? `камер к поставке: ${values.hardwareCount}` : "",
        values.installNeed ? "нужен монтаж" : ""
      ].filter(Boolean);
      return `Видеонаблюдение: ${summaryParts.join(", ")}`;
    }

    if (type === "telephony") {
      if (config.telephonyVariant === "basic") {
        return `Обычное подключение: ${values.connectionType === "analog" ? "аналоговое" : "цифровое"}, ${values.tariff === "timed" ? "повременный тариф" : "безлимитный тариф"}`;
      }

      if (config.telephonyVariant === "multichannel") {
        return `Многоканальный телефон: ${formatPortCount(Number(values.ports))}`;
      }

      if (config.telephonyVariant === "pro") {
        return `Серия ПРО: ${formatNumberCount(Number(values.phoneNumbers), true)}, ${formatLineCount(Number(values.externalLines), true)}`;
      }

      return `Виртуальная АТС: ${formatPortCount(Number(values.ports), true)}, ${formatNumberCount(Number(values.phoneNumbers))}, ${formatLineCount(Number(values.externalLines))}`;
    }

    if (type === "vps") {
      return `VPS: ${values.vCpu} CPU, ${values.ramGb}\u00a0ГБ RAM`;
    }

    const internetLabels: Record<string, string> = {
      "100m": "100 Мбит/с",
      "1g-50tb": "1 Гбит/с (50 ТБ)",
      "1g-unlimited": "1 Гбит/с (безлимит)"
    };
    const internetPlan = internetLabels[String(values.internetPlan)] ?? values.internetPlan;
    return `Размещение: ${values.rackUnits}U, ${values.powerWatts}\u00a0Вт, интернет ${internetPlan}`;
  }

  function buildConfigurationText(summary: string, result: any, showKnownTotals: boolean) {
    const hasQuoteItems = result.unknownItems.length > 0;
    const canPublishEstimate = !result.forceIndividual && (!hasQuoteItems || showKnownTotals);
    const totals = [
      result.forceIndividual
        ? "персональный расчёт"
        : hasQuoteItems
          ? showKnownTotals
            ? "часть позиций по запросу"
            : "индивидуальный расчёт"
          : "",
      canPublishEstimate && result.hasMonthly ? `ежемесячно ${formatRubles(result.monthly)}` : "",
      canPublishEstimate && result.hasOneTime ? `разово ${formatRubles(result.oneTime)}` : "",
      hasQuoteItems ? `по запросу: ${result.unknownItems.join(", ")}` : ""
    ].filter(Boolean);

    return `${summary}. ${totals.join("; ")}.`;
  }

  function formatRubles(value: number) {
    return new Intl.NumberFormat("ru-RU", {
      style: "currency",
      currency: "RUB",
      maximumFractionDigits: 0
    }).format(value);
  }

  function formatPortCount(quantity: number, internal = false) {
    return formatRussianQuantity(
      quantity,
      internal
        ? ["внутренний порт", "внутренних порта", "внутренних портов"]
        : ["порт", "порта", "портов"]
    );
  }

  function formatNumberCount(quantity: number, tfop = false) {
    return formatRussianQuantity(
      quantity,
      tfop ? ["номер ТФОП", "номера ТФОП", "номеров ТФОП"] : ["номер", "номера", "номеров"]
    );
  }

  function formatLineCount(quantity: number, connection = false) {
    return formatRussianQuantity(
      quantity,
      connection
        ? ["соединительная линия", "соединительные линии", "соединительных линий"]
        : ["внешняя линия", "внешние линии", "внешних линий"]
    );
  }

  function formatRussianQuantity(quantity: number, forms: [string, string, string]) {
    const absoluteQuantity = Math.abs(quantity) % 100;
    const lastDigit = absoluteQuantity % 10;
    const formIndex =
      absoluteQuantity >= 11 && absoluteQuantity <= 14
        ? 2
        : lastDigit === 1
          ? 0
          : lastDigit >= 2 && lastDigit <= 4
            ? 1
            : 2;

    return `${quantity} ${forms[formIndex]}`;
  }
</script>
