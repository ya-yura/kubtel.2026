---
import { formatRubles } from "@lib/format";
import { calculateMonthlyPrice } from "@lib/pricing";
import { getSitePath } from "@config/site";
import type { Tariff, TariffOption } from "@models/domain";

type Props = {
  tariffs: Tariff[];
};

const { tariffs } = Astro.props;

const optionLabels: Record<TariffOption, string> = {
  routerRent: "Роутер",
  staticIp: "Статический IP",
  tvPack: "ТВ"
};
---

<section class="section-pad comparison-section" id="tariff-compare">
  <div class="section-heading">
    <p class="eyebrow">Сравнение</p>
    <h2>Сравните тарифы и условия</h2>
    <p>
      Скорость, стоимость и состав — на одной странице. Если останутся вопросы, всё спокойно обсудим
      с человеком.
    </p>
  </div>
  <div class="tariff-comparison-grid" aria-label="Тарифы для сравнения">
    {
      tariffs.map((tariff) => {
        const price = calculateMonthlyPrice(tariff);
        const speedIsKnown = tariff.commercialReview.speedStatus === "confirmed";
        const priceIsKnown = tariff.commercialReview.priceStatus === "confirmed";
        const connectionIsKnown =
          tariff.commercialReview.connectionStatus === "confirmed" &&
          tariff.connectionPrice !== null;

        return (
          <article
            class:list={[
              "tariff-comparison-card",
              { "tariff-comparison-card--featured": tariff.isFeatured }
            ]}
          >
            <header class="tariff-comparison-card__header">
              {tariff.isFeatured && <span class="tariff-comparison-card__badge">Рекомендуем</span>}
              <h3>{tariff.title}</h3>
              <p>{tariff.bestFor.slice(0, 2).join(" · ")}</p>
            </header>

            <div class="tariff-comparison-card__price">
              <span>Абонентская плата</span>
              <strong class:list={{ "is-pending": !priceIsKnown }}>
                {priceIsKnown ? `${formatRubles(price.total)}/мес.` : "По адресу"}
              </strong>
            </div>

            <dl class="tariff-comparison-card__facts">
              <div>
                <dt>Скорость</dt>
                <dd class:list={{ "is-pending": !speedIsKnown }}>
                  {speedIsKnown ? `${tariff.speedDownload} Мбит/с` : "Уточним по адресу"}
                </dd>
              </div>
              <div>
                <dt>В составе</dt>
                <dd class="tariff-comparison-card__options">
                  {tariff.availableOptions.map((option) => (
                    <span>{optionLabels[option as TariffOption]}</span>
                  ))}
                </dd>
              </div>
              <div>
                <dt>Подключение</dt>
                <dd class:list={{ "is-pending": !connectionIsKnown }}>
                  {connectionIsKnown
                    ? formatRubles(tariff.connectionPrice ?? 0)
                    : "Уточним на звонке"}
                </dd>
              </div>
            </dl>

            <footer class="tariff-comparison-card__footer">
              <a
                class="card-action"
                href={getSitePath(`/individual/configurator/?service=internet#configurator`)}
                aria-label={`Выбрать тариф ${tariff.title}`}
              >
                Выбрать тариф
              </a>
            </footer>
          </article>
        );
      })
    }
  </div>
</section>
