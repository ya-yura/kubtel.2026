---
import PromoImage from "@components/ui/PromoImage.astro";
import TariffCard from "@components/ui/TariffCard.astro";
import { promoVisuals } from "@lib/visuals";
import type { Tariff } from "@models/domain";
import SectionHeading from "@components/ui/SectionHeading.astro";

type Props = {
  tariffs: Tariff[];
  title?: string;
  lead?: string;
};

const {
  tariffs,
  title = "Тарифы для домашнего подключения",
  lead = "Скорость, цена и состав услуг должны быть видны до заявки. Коммерческое использование связи оформляется отдельными B2B-условиями."
} = Astro.props;
---

<section class="section-pad tariffs-section">
  <div class="visual-section-head">
    <SectionHeading eyebrow="Тарифная сетка" title={title} description={lead} />
    <PromoImage visual={promoVisuals.entertainment} class="is-inline" />
  </div>
  <div class="tariff-grid">
    {tariffs.map((tariff) => <TariffCard tariff={tariff} />)}
  </div>
</section>
