---
import PromoImage from "@components/ui/PromoImage.astro";
import SeasonalDecorations from "@components/layout/SeasonalDecorations.astro";
import { HOMEPAGE_CONFIG, isFeatureEnabled } from "@config/homepage";
import { getPhoneHref, getSitePath, SITE } from "@config/site";
import { promoVisuals } from "@lib/visuals";

const showHeroVisual = isFeatureEnabled(HOMEPAGE_CONFIG.hero.mode);
---

<section
  class:list={[
    "homepage-hero",
    "section-pad",
    { "homepage-hero--with-visual": showHeroVisual, "homepage-hero--compact": !showHeroVisual }
  ]}
  aria-labelledby="homepage-hero-title"
>
  <div class="homepage-hero__content">
    <div class="homepage-hero__intro">
      <p class="eyebrow">Kubtel · Краснодар</p>
      <h1 id="homepage-hero-title">Связь по-человечески</h1>
      <p class="homepage-hero__lead">
        Без ботов и&nbsp;бесконечных переключений. Расскажите, что нужно, — мы вникнем
        и&nbsp;поможем решить вопрос для дома или бизнеса.
      </p>
    </div>

    <div class="homepage-audience" aria-label="Выберите аудиторию">
      <a
        class="homepage-audience__choice homepage-audience__choice--individual"
        href={getSitePath("/individual/")}
      >
        <span class="homepage-audience__kicker">Физлица</span>
        <strong>Для дома</strong>
        <span>Интернет, ТВ и видеонаблюдение</span>
        <span class="homepage-audience__arrow" aria-hidden="true">↗</span>
      </a>
      <a
        class="homepage-audience__choice homepage-audience__choice--business"
        href={getSitePath("/business/")}
      >
        <span class="homepage-audience__kicker">Организации</span>
        <strong>Для бизнеса и&nbsp;государства</strong>
        <span>Связь, инфраструктура и&nbsp;персональный маршрут</span>
        <span class="homepage-audience__arrow" aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="homepage-quick-actions" aria-label="Быстрые действия физлица">
      <div class="homepage-quick-actions__grid">
        <a
          class="homepage-quick-action homepage-quick-action--primary"
          href={SITE.paymentUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <strong>Оплатить услуги</strong>
          <span>Быстрый переход к оплате</span>
        </a>
        <a
          class="homepage-quick-action"
          href={SITE.accountUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <strong>Личный кабинет</strong>
          <span>Баланс, услуги и договор</span>
        </a>
        <a class="homepage-quick-action" href={getSitePath("/tariffs/")}>
          <strong>Выбрать тариф</strong>
          <span>Сравнить скорость и условия</span>
        </a>
      </div>
    </div>

    <a class="homepage-phone" href={getPhoneHref(SITE.salesPhone)}>
      <span>Не нашли нужное?</span>
      <strong>{SITE.salesPhone}</strong>
      <span>Позвонить человеку</span>
    </a>
  </div>

  <SeasonalDecorations />

  {
    showHeroVisual && (
      <div class="homepage-hero__visual" aria-label="Графический hero-блок">
        <PromoImage
          visual={promoVisuals.home}
          class="is-hero"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }
</section>
