---
import PromoImage from "@components/ui/PromoImage.astro";
import { getSitePath } from "@config/site";
import { promoVisuals } from "@lib/visuals";
---

<section class="hero section-pad">
  <div class="hero-copy">
    <p class="eyebrow">Краснодар, квартиры, ЖК и&nbsp;частный сектор</p>
    <h1>Домашний интернет, где трубку берёт человек</h1>
    <p class="hero-lead">
      Kubtel выбирают, когда важны понятные условия, живой контакт и&nbsp;аккуратное подключение.
      Можно самому посмотреть тарифы, оплатить услуги или обратиться в поддержку, а заявку на
      подключение оставить тогда, когда нужен разговор со специалистом.
    </p>
    <div class="audience-switch" aria-label="Выберите направление">
      <a class="audience-card is-active" href={getSitePath("/connect/#callback-request")}>
        <span>Для дома</span>
        <strong>Надёжный интернет домой</strong>
        <small>Тарифы, проверка адреса и&nbsp;понятные условия без скрытых платежей.</small>
      </a>
      <a class="audience-card" href={getSitePath("/business/")}>
        <span>Для бизнеса</span>
        <strong>Связь без простоя</strong>
        <small>Интернет, Hot-spot, телефония, камеры, VPS и&nbsp;размещение.</small>
      </a>
      <a class="audience-login" href="#subscriber-tools">Личный кабинет абонента</a>
    </div>
    <form
      class="address-inline"
      action={getSitePath("/connect/#callback-request")}
      method="get"
      aria-label="Быстрая заявка на обратный звонок"
    >
      <label>
        <span>Телефон для звонка</span>
        <input name="phone" type="tel" inputmode="tel" placeholder="+7" autocomplete="tel" />
      </label>
      <button type="submit">Уточнить подключение</button>
    </form>
  </div>
  <div class="hero-visual-stack">
    <PromoImage visual={promoVisuals.home} class="is-hero" loading="eager" fetchpriority="high" />
    <div class="hero-panel" aria-label="Ключевые преимущества">
      <div>
        <span class="metric">1</span>
        <p>номер телефона нужен, чтобы начать разговор о&nbsp;подключении</p>
      </div>
      <div>
        <span class="metric">0</span>
        <p>скрытых платежей и&nbsp;игр со&nbsp;скоростью в&nbsp;обещании Kubtel</p>
      </div>
      <div>
        <span class="metric">люди</span>
        <p>местная команда вместо длинной цепочки переключений</p>
      </div>
    </div>
  </div>
</section>
