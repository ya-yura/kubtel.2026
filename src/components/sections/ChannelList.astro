---
import type { ChannelGroup } from "@models/configurator";
import { getSitePath } from "@config/site";

type Props = {
  groups: ChannelGroup[];
  channelCount: number;
};

const { groups, channelCount } = Astro.props;

function getChannelInitials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join("")
    .toUpperCase();
}

function getChannelLogoSrc(path: string): string {
  return path.startsWith("/") ? getSitePath(path) : path;
}
---

<section class="channel-panel" id="channels" data-channel-list>
  <div class="section-heading">
    <p class="eyebrow">Телевидение</p>
    <h2>Каналы единого пакета ({channelCount})</h2>
    <p>
      Все доступные каналы собраны в одном пакете. Найдите канал по названию или категории, нажмите
      на карточку и откройте его описание.
    </p>
  </div>
  <div class="channel-tools">
    <label class="channel-search">
      <span>Поиск по каналам</span>
      <input
        type="search"
        name="channel-search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Например, «Матч» или «кино»…"
        data-channel-search
      />
    </label>
    <div class="channel-filters" role="group" aria-label="Фильтр каналов">
      <button type="button" class="is-active" data-channel-filter="all">Все каналы</button>
      {
        groups.map((group) => (
          <button type="button" data-channel-filter={group.id}>
            {group.title}
          </button>
        ))
      }
    </div>
  </div>
  <p class="channel-result" data-channel-result aria-live="polite">Показаны все каналы</p>
  <div class="channel-groups">
    {
      groups.map((group) => (
        <section class="channel-group" data-channel-group={group.id}>
          <div class="channel-group-head">
            <h3>{group.title}</h3>
            <span>{group.channels.length}</span>
          </div>
          <ul class="channel-grid">
            {group.channels.map((channel) => (
              <li
                data-channel
                data-channel-category={group.id}
                data-channel-name={channel.name.toLocaleLowerCase("ru-RU")}
              >
                <details class="channel-card">
                  <summary class="channel-card-summary">
                    <span class="channel-logo">
                      {channel.logo ? (
                        <>
                          <img
                            src={getChannelLogoSrc(channel.logo)}
                            alt=""
                            width="64"
                            height="64"
                            loading="lazy"
                            decoding="async"
                            data-channel-logo
                          />
                          <span class="channel-logo-fallback" aria-hidden="true" hidden>
                            {getChannelInitials(channel.name)}
                          </span>
                        </>
                      ) : (
                        <span class="channel-logo-fallback" aria-hidden="true">
                          {getChannelInitials(channel.name)}
                        </span>
                      )}
                    </span>
                    <span class="channel-card-copy">
                      <strong>{channel.name}</strong>
                      <small>Открыть описание</small>
                    </span>
                    <span class="channel-card-chevron" aria-hidden="true">
                      ⌄
                    </span>
                  </summary>
                  <div class="channel-card-description">
                    <p>{channel.description || "Описание канала пока не опубликовано."}</p>
                  </div>
                </details>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <p class="channel-empty" data-channel-empty hidden>
    Ничего не найдено. Попробуйте другой запрос.
  </p>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-channel-list]").forEach((root) => {
    const search = root.querySelector<HTMLInputElement>("[data-channel-search]");
    const result = root.querySelector<HTMLElement>("[data-channel-result]");
    const empty = root.querySelector<HTMLElement>("[data-channel-empty]");
    let activeCategory = "all";

    root.querySelectorAll<HTMLImageElement>("[data-channel-logo]").forEach((image) => {
      image.addEventListener("error", () => {
        image.hidden = true;
        const fallback = image.parentElement?.querySelector<HTMLElement>(".channel-logo-fallback");
        if (fallback) fallback.hidden = false;
      });
    });

    const update = () => {
      const query = (search?.value ?? "").trim().toLocaleLowerCase("ru-RU");
      let visibleCount = 0;

      root.querySelectorAll<HTMLElement>("[data-channel]").forEach((channel) => {
        const matchesCategory =
          activeCategory === "all" || channel.dataset.channelCategory === activeCategory;
        const matchesQuery = !query || (channel.dataset.channelName ?? "").includes(query);
        const isVisible = matchesCategory && matchesQuery;
        channel.hidden = !isVisible;
        visibleCount += isVisible ? 1 : 0;
      });

      root.querySelectorAll<HTMLElement>("[data-channel-group]").forEach((group) => {
        group.hidden = group.querySelectorAll("[data-channel]:not([hidden])").length === 0;
      });

      if (result) {
        result.textContent = query
          ? `Найдено каналов: ${visibleCount}`
          : activeCategory === "all"
            ? "Показаны все каналы"
            : `Категория: ${root.querySelector(`[data-channel-filter="${activeCategory}"]`)?.textContent ?? "выбрана"}`;
      }

      if (empty) {
        empty.hidden = visibleCount > 0;
      }
    };

    search?.addEventListener("input", update);
    root.querySelectorAll<HTMLButtonElement>("[data-channel-filter]").forEach((button) => {
      button.addEventListener("click", () => {
        activeCategory = button.dataset.channelFilter ?? "all";
        root
          .querySelectorAll("[data-channel-filter]")
          .forEach((item) => item.classList.remove("is-active"));
        button.classList.add("is-active");
        update();
      });
    });

    update();
  });
</script>

<style>
  .channel-panel .channel-group ul.channel-grid {
    display: grid;
    gap: 0.65rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .channel-panel {
    margin-inline: auto;
    max-width: var(--kb-layout-content-max-width);
    padding: clamp(2rem, 4vw, 4rem) var(--kb-layout-page-inline-padding);
    width: min(100%, var(--kb-layout-content-max-width));
  }

  .channel-panel .section-heading {
    max-width: 48rem;
  }

  .channel-panel .channel-tools {
    align-items: end;
    grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.25fr);
  }

  .channel-panel .channel-filters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
  }

  .channel-panel .channel-filters button {
    text-align: center;
    width: 100%;
  }

  .channel-panel .channel-groups {
    gap: 1.25rem;
  }

  .channel-panel .channel-group {
    padding: 1.25rem;
  }

  .channel-panel .channel-grid > li {
    background: transparent;
    border: 0;
    min-width: 0;
    padding: 0;
  }

  .channel-card {
    background: var(--kb-component-card-background);
    border: 1px solid var(--kb-component-card-border);
    border-radius: var(--kb-shape-card);
    box-shadow: none;
    overflow: hidden;
    transition:
      border-color var(--kb-motion-duration-fast) var(--kb-motion-easing-standard),
      box-shadow var(--kb-motion-duration-fast) var(--kb-motion-easing-standard);
  }

  .channel-card:hover,
  .channel-card[open] {
    border-color: var(--kb-color-overlay-accent42);
    box-shadow: var(--kb-elevation-selected-subtle);
  }

  .channel-card-summary {
    align-items: center;
    cursor: pointer;
    display: grid;
    gap: 0.65rem;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    list-style: none;
    min-height: 5.2rem;
    padding: 0.7rem;
  }

  .channel-card-summary::-webkit-details-marker {
    display: none;
  }

  .channel-logo {
    align-items: center;
    background: var(--kb-color-surface-soft);
    border: 1px solid var(--kb-component-card-border);
    border-radius: var(--kb-shape-control-small);
    display: grid;
    aspect-ratio: 1;
    height: 4rem;
    justify-items: center;
    overflow: hidden;
    width: 4rem;
  }

  .channel-logo img {
    display: block;
    height: auto;
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    padding: 0.28rem;
    width: auto;
  }

  .channel-logo-fallback {
    color: var(--kb-color-action-primary-background);
    font-family: var(--kb-typography-display-family);
    font-size: 0.72rem;
    font-weight: 900;
  }

  .channel-card-copy {
    display: grid;
    gap: 0.18rem;
    min-width: 0;
  }

  .channel-card-copy strong {
    color: var(--kb-color-text-primary);
    font-size: 0.9rem;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .channel-card-copy small {
    color: var(--kb-color-text-secondary);
    font-size: 0.72rem;
  }

  .channel-card-chevron {
    color: var(--kb-color-text-secondary);
    font-size: 1.25rem;
    line-height: 1;
    transition:
      color var(--kb-motion-duration-fast) var(--kb-motion-easing-standard),
      transform var(--kb-motion-duration-fast) var(--kb-motion-easing-standard);
  }

  .channel-card[open] .channel-card-chevron {
    color: var(--kb-color-action-primary-background);
    transform: rotate(180deg);
  }

  .channel-card-description {
    border-top: 1px solid var(--kb-component-card-border);
    padding: 0.75rem;
  }

  .channel-card-description p {
    font-size: 0.82rem;
    margin: 0;
  }

  @media (max-width: 719px) {
    .channel-panel {
      padding-inline: 1rem;
      width: 100%;
    }

    .channel-panel .channel-tools {
      grid-template-columns: 1fr;
    }

    .channel-panel .channel-filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .channel-panel .channel-group ul.channel-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .channel-card-summary {
      gap: 0.5rem;
      grid-template-columns: 3.25rem minmax(0, 1fr) auto;
      min-height: 4.8rem;
      padding: 0.55rem;
    }

    .channel-logo {
      height: 3.25rem;
      width: 3.25rem;
    }
  }
</style>
