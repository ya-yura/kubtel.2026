---
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import StickyCta from "@components/layout/StickyCta.astro";
import { getAbsoluteUrl, getSitePath, SITE } from "@config/site";
import { getRouteMetadata } from "@config/routes";
import {
  buildBaseStructuredData,
  serializeJsonLd,
  type JsonLdObject,
  type PageSchemaType
} from "@lib/seo/schema";
import "@styles/tokens.css";
import "@styles/global.css";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  pageType?: PageSchemaType;
  schema?: JsonLdObject | JsonLdObject[];
};

const {
  title: providedTitle,
  description: providedDescription,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  pageType = "WebPage",
  schema = []
} = Astro.props;

const normalizedCanonicalPath = canonicalPath.startsWith("/") ? canonicalPath : `/${canonicalPath}`;
const routeMetadata = getRouteMetadata(normalizedCanonicalPath);
const title = providedTitle ?? routeMetadata?.title ?? SITE.defaultTitle;
const description = providedDescription ?? routeMetadata?.description ?? SITE.defaultDescription;
const pageTitle =
  title === SITE.defaultTitle ? SITE.defaultTitle : SITE.titleTemplate.replace("%s", title);
const canonicalUrl = getAbsoluteUrl(normalizedCanonicalPath);
const robotsContent = noindex ? "noindex,nofollow" : "index,follow";
const pageSchema = buildBaseStructuredData({
  pageType,
  title: pageTitle,
  description,
  canonicalPath: normalizedCanonicalPath,
  canonicalUrl,
  breadcrumbLabel: routeMetadata?.label
});
const pageStructuredData = [...pageSchema, ...(Array.isArray(schema) ? schema : [schema])].filter(
  Boolean
);
const quietStickySections = [
  "/payment/",
  "/support/",
  "/documents/",
  "/contacts/",
  "/about/",
  "/news/",
  "/search/",
  "/devices/",
  "/careers/",
  "/design-system/"
];
const hasStickyCta =
  normalizedCanonicalPath !== "/" &&
  !quietStickySections.some((path) => Astro.url.pathname.startsWith(path));
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="application-name" content={SITE.name} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={getSitePath("/favicon.ico")} sizes="any" />
    <link rel="icon" href={getSitePath("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={getSitePath("/apple-touch-icon.png")} />
    <link rel="manifest" href={getSitePath("/site.webmanifest")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Andika:wght@400;700&family=Golos+Text:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800;900&family=Unbounded:wght@500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {
      pageStructuredData.map((item) => (
        <script is:inline type="application/ld+json" set:html={serializeJsonLd(item)} />
      ))
    }
    <title>{pageTitle}</title>
  </head>
  <body
    class:list={{
      "has-sticky-cta": hasStickyCta,
      "is-homepage": normalizedCanonicalPath === "/"
    }}
  >
    <a class="skip-link" href="#main-content">К основному содержимому</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <StickyCta />
    <Footer />
    <script is:inline>
      (() => {
        const shortWordPattern =
          /(^|[\s([{«„—–-])((?:а|и|но|да|же|бы|ли|в|во|к|ко|с|со|у|о|об|от|из|за|на|по|до|без|для|над|под|при|не|ни))\s+(?=[\p{L}\p{N}])/giu;
        const ignoredTags = new Set([
          "CODE",
          "INPUT",
          "NOSCRIPT",
          "PRE",
          "SCRIPT",
          "SELECT",
          "STYLE",
          "TEXTAREA"
        ]);
        const textWalker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
        const textNodes = [];
        let currentNode;

        while ((currentNode = textWalker.nextNode())) {
          const parent = currentNode.parentElement;
          if (
            !parent ||
            ignoredTags.has(parent.tagName) ||
            parent.closest("[contenteditable='true']")
          ) {
            continue;
          }
          textNodes.push(currentNode);
        }

        textNodes.forEach((node) => {
          node.nodeValue = node.nodeValue?.replace(shortWordPattern, "$1$2\u00a0") ?? "";
        });

        const storageKey = "kubtel-readable-mode";
        const readableClass = "is-readable";
        const toggles = [...document.querySelectorAll("[data-readability-toggle]")];

        function applyReadableMode(enabled) {
          document.body.classList.toggle(readableClass, enabled);
          toggles.forEach((toggle) => {
            toggle.setAttribute("aria-pressed", String(enabled));
            if (toggle.classList.contains("header-readability-toggle")) {
              toggle.textContent = enabled ? "A-" : "A+";
              toggle.setAttribute(
                "aria-label",
                enabled ? "Отключить версию для слабовидящих" : "Включить версию для слабовидящих"
              );
            }
          });
        }

        const initialState = localStorage.getItem(storageKey) === "true";
        applyReadableMode(initialState);

        toggles.forEach((toggle) => {
          toggle.addEventListener("click", () => {
            const nextState = !document.body.classList.contains(readableClass);
            localStorage.setItem(storageKey, String(nextState));
            applyReadableMode(nextState);
          });
        });
      })();
    </script>
  </body>
</html>
